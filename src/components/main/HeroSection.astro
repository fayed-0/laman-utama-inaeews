<section id="hero" class="min-h-screen w-full snap-start flex items-center px-12 md:px-24 bg-white py-24 lg:py-32">
	<div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center w-full max-w-7xl mx-auto">
		<div class="space-y-6 md:space-y-10">
			<div class="space-y-4 md:space-y-6">
				<p class="text-blue-600 text-[10px] md:text-sm font-black uppercase tracking-[0.3em] font-accent">Peringatan Dini Gempa Bumi</p>
				<h1 class="text-[clamp(2.5rem,8vw,5rem)] font-black leading-[0.95] tracking-tighter text-slate-900 break-words">
					Apa itu <br class="hidden xl:block"/><span class="text-blue-600">InaEEWS?</span>
				</h1>
			</div>
			<p class="text-slate-500 text-[clamp(0.875rem,2vw,1.25rem)] font-medium leading-relaxed max-w-lg">
				Indonesia Earthquake Early Warning System adalah infrastruktur teknologi yang dirancang untuk mendeteksi gelombang seismik awal dan memberikan peringatan detik - detik berharga sebelum getaran utama merusak mencapai lokasi Anda.
			</p>
			<div class="flex gap-4">
				<div class="size-10 rounded-full bg-slate-100 flex items-center justify-center hover:bg-blue-600 transition-colors cursor-pointer text-slate-600 hover:text-white">
					<span class="material-symbols-outlined text-sm">public</span>
				</div>
				<div class="size-10 rounded-full bg-slate-100 flex items-center justify-center hover:bg-blue-600 transition-colors cursor-pointer text-slate-600 hover:text-white">
					<span class="material-symbols-outlined text-sm">verified_user</span>
				</div>
				<div class="size-10 rounded-full bg-slate-100 flex items-center justify-center hover:bg-slate-400 transition-colors cursor-pointer text-slate-600 hover:text-white">
					<span class="material-symbols-outlined text-sm">share</span>
				</div>
			</div>
		</div>

		<div class="relative w-full aspect-video rounded-[2.5rem] overflow-hidden border-2 border-slate-100 shadow-xl group/video" id="video-wrapper">
			<iframe id="youtube-iframe" class="w-full h-full"
				src="https://www.youtube-nocookie.com/embed/Gwdp6_1oivI?mute=1&enablejsapi=1"
				frameborder="0" allow="autoplay; fullscreen" allowfullscreen>
			</iframe>
			<div id="video-overlay" class="absolute inset-0 bg-white/60 backdrop-blur-3xl flex flex-col items-center justify-center cursor-pointer transition-all duration-700 hover:backdrop-blur-xl">
				<div class="size-24 rounded-full bg-blue-600/90 flex items-center justify-center shadow-2xl shadow-blue-600/40 group-hover/video:scale-110 transition-transform">
					<span class="material-symbols-outlined text-5xl text-white">play_arrow</span>
				</div>
				<p class="mt-6 text-slate-900 text-xs font-black uppercase tracking-[0.4em] opacity-60">Tonton Video</p>
			</div>
		</div>
	</div>

	<!-- Video Popup / Modal -->
	<div
		id="video-modal"
		class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/80 backdrop-blur-sm p-6 opacity-0 transition-opacity duration-300"
	>
		<div id="video-modal-panel" class="relative w-full max-w-4xl scale-95 transition-transform duration-300">
			<button
				id="video-modal-close"
				type="button"
				aria-label="Tutup video"
				class="absolute -top-4 -right-4 md:-top-5 md:-right-5 size-10 md:size-11 rounded-full bg-white text-slate-700 shadow-xl flex items-center justify-center hover:bg-blue-600 hover:text-white transition-colors z-10"
			>
				<span class="material-symbols-outlined text-2xl">close</span>
			</button>
			<div class="w-full aspect-video rounded-2xl overflow-hidden shadow-2xl bg-black">
				<iframe id="youtube-iframe-modal" class="w-full h-full" src=""
					frameborder="0" allow="autoplay; fullscreen" allowfullscreen>
				</iframe>
			</div>
		</div>
	</div>
</section>

<script>
	const overlay = document.getElementById('video-overlay');
	const modal = document.getElementById('video-modal');
	const modalPanel = document.getElementById('video-modal-panel');
	const modalCloseBtn = document.getElementById('video-modal-close');
	const modalIframe = document.getElementById('youtube-iframe-modal') as HTMLIFrameElement;

	const VIDEO_ID = 'Gwdp6_1oivI';
	const AUTOPLAY_SRC = `https://www.youtube-nocookie.com/embed/${VIDEO_ID}?autoplay=1&mute=0&enablejsapi=1`;

	function openVideoModal() {
		if (!modal || !modalPanel || !modalIframe) return;

		modalIframe.src = AUTOPLAY_SRC;
		modal.classList.remove('hidden');
		modal.classList.add('flex');
		document.body.classList.add('overflow-hidden');

		// Trigger transition on next frame
		requestAnimationFrame(() => {
			modal.classList.remove('opacity-0');
			modalPanel.classList.remove('scale-95');
			modalPanel.classList.add('scale-100');
		});
	}

	function closeVideoModal() {
		if (!modal || !modalPanel || !modalIframe) return;

		modal.classList.add('opacity-0');
		modalPanel.classList.remove('scale-100');
		modalPanel.classList.add('scale-95');
		document.body.classList.remove('overflow-hidden');

		setTimeout(() => {
			modal.classList.add('hidden');
			modal.classList.remove('flex');
			// Stop playback by clearing the src
			modalIframe.src = '';
		}, 300);
	}

	overlay?.addEventListener('click', openVideoModal);

	modalCloseBtn?.addEventListener('click', closeVideoModal);

	// Close when clicking the backdrop (outside the video panel)
	modal?.addEventListener('click', (e) => {
		if (e.target === modal) {
			closeVideoModal();
		}
	});

	// Close on Escape key
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
			closeVideoModal();
		}
	});
</script>