---
---
<section class="min-h-screen snap-start w-full flex items-center py-20 bg-slate-50 dark:bg-slate-950 transition-colors duration-500 overflow-hidden relative">
  <div class="container mx-auto px-6">
    <div class="flex flex-col lg:flex-row items-center gap-16">

      <!-- Text Content Area -->
      <div class="lg:w-1/2 space-y-8 z-10 text-left">
        <div class="inline-flex items-center px-4 py-2 rounded-full bg-orange-100 dark:bg-orange-900/30 text-orange-600 dark:text-orange-300 text-sm font-bold uppercase tracking-widest border border-orange-200 dark:border-orange-800">
          <span class="material-symbols-outlined text-sm mr-2">waves</span>
          Konsep Deteksi
        </div>

        <h2 class="text-3xl md:text-5xl font-black text-slate-900 dark:text-white leading-tight">
          Gelombang <span class="bg-clip-text text-transparent bg-gradient-to-r from-orange-500 to-red-600 font-black">Primer & Sekunder</span>
        </h2>

        <div class="space-y-6 text-lg text-slate-600 dark:text-slate-400 leading-relaxed text-left">
          <p>
            InaEEWS memanfaatkan jaringan sensor gempa untuk mendeteksi getaran awal
            <strong class="text-blue-500 font-bold">(Gelombang P)</strong> yang bergerak lebih cepat namun tidak berbahaya.
          </p>
          <p>
            Data ini diproses dalam hitungan detik untuk memperkirakan area yang akan terdampak guncangan lebih kuat
            <strong class="text-red-500 font-bold">(Gelombang S)</strong>, lalu sistem segera mengirimkan peringatan ke aplikasi.
          </p>
          <div class="p-6 rounded-2xl bg-orange-50 dark:bg-orange-900/10 border-l-4 border-orange-500 shadow-sm">
            <p class="font-bold text-slate-800 dark:text-slate-200">Prinsip Selisih Waktu:</p>
            <p class="text-sm md:text-base mt-2 italic">
              "Karena gelombang S lebih lambat dari gelombang P, pengguna berpeluang menerima peringatan beberapa detik sebelum guncangan merusak terasa."
            </p>
          </div>
        </div>

      </div>

      <!-- Animation Panel -->
      <div class="lg:w-1/2 w-full" style="position:relative;">
        <div id="inaews-panel" style="
          background:#fff;
          border-radius:10px;
          overflow:hidden;
          border:1px solid #e2e8f0;
          box-shadow: 0 25px 50px -12px rgba(0,0,0,0.12);
          display:flex; flex-direction:column;
        ">
          <!-- Progress bar inside card -->
          <div style="height:4px;background:#e2e8f0;flex-shrink:0;">
            <div id="inaews-progress" style="height:100%;width:0%;background:#2563eb;transition:width 0.1s linear;"></div>
          </div>

          <!-- Canvas area -->
          <div style="position:relative;height:500px;flex-shrink:0;">
            <canvas id="inaews-canvas" style="position:absolute;inset:0;width:100%;height:100%;"></canvas>

            <!-- Warning pill -->
            <div id="inaews-warn" style="
              position:absolute; top:16px; left:50%; transform:translateX(-50%);
              background:#dc2626; color:#fff;
              font-size:11px; font-weight:800; letter-spacing:0.1em;
              padding:6px 20px; border-radius:20px;
              opacity:0; transition:opacity 0.5s;
              pointer-events:none; white-space:nowrap;
              box-shadow:0 4px 14px rgba(220,38,38,0.4);
              z-index:5;
            ">⚠ PERINGATAN TERKIRIM !</div>

            <!-- Step caption -->
            <div id="inaews-caption" style="
              position:absolute; bottom:14px; left:50%; transform:translateX(-50%);
              background:rgba(15,23,42,0.82); color:#fff;
              font-size:12px; font-weight:600; line-height:1.5;
              padding:7px 16px; border-radius:20px;
              white-space:nowrap; pointer-events:none;
              opacity:0; transition:opacity 0.3s;
              backdrop-filter:blur(6px); z-index:5;
            "></div>
          </div>

          <!-- Play/Replay button — overlaid inside canvas, bottom-right -->
          <button id="wave-controller"
            onclick="window._inaeewsStart && window._inaeewsStart()"
            style="
              position:absolute; bottom:14px; right:14px; z-index:20;
              background:#2563eb; color:#fff; border:none; border-radius:50%;
              width:40px; height:40px; cursor:pointer;
              display:flex; align-items:center; justify-content:center;
              box-shadow:0 4px 16px rgba(37,99,235,0.4);
            ">
            <span class="material-symbols-outlined" id="controller-icon" style="font-size:20px;line-height:1;">play_arrow</span>
          </button>
        </div>
      </div>

    </div>
  </div>
</section>

<script is:inline>
(function() {
  function initInaEEWS() {
    const panel   = document.getElementById('inaews-panel');
    const canvas  = document.getElementById('inaews-canvas');
    const caption = document.getElementById('inaews-caption');
    const warn    = document.getElementById('inaews-warn');
    const progress= document.getElementById('inaews-progress');
    const btn     = document.getElementById('wave-controller');
    const btnIcon = document.getElementById('controller-icon');
    const hint    = null;
    const ctx     = canvas.getContext('2d');

    let W, H, QX, QY, SX, SY, PHX, PHY;
    let raf, running = false;
    let frame = 0, phase = 0, phaseF = 0;

    const TOTAL_FRAMES = 60 + 200 + 90 + 120 + 260 + 70; // 800

    const PHASES = [
      { frames: 60,  caption: 'Gempa terjadi — energi seismik dilepaskan' },
      { frames: 200, caption: 'Gelombang P (biru) menyebar cepat, tidak merusak' },
      { frames: 90,  caption: 'Gelombang P tiba di Sensor BMKG — data diproses' },
      { frames: 120, caption: 'Peringatan dikirim ke HP pengguna' },
      { frames: 260, caption: 'Gelombang S (merah) menyusul — lebih lambat, lebih kuat' },
      { frames: 70,  caption: 'Selisih waktu ini = kesempatan pengguna berlindung' },
    ];

    const pRings = [], sRings = [];
    let quakePulse = 0;
    let sensorLit = 0;          // 0-1
    let signalT = -1;           // -1 = belum mulai, 0-1 = progress
    let phoneAlert = 0;         // 0-1
    let phoneBuzz = 0;
    let sWaveStarted = false;

    function resize() {
      const r = panel.getBoundingClientRect();
      W = r.width; H = r.height;
      canvas.width  = W * devicePixelRatio;
      canvas.height = H * devicePixelRatio;
      canvas.style.width  = W + 'px';
      canvas.style.height = H + 'px';
      ctx.scale(devicePixelRatio, devicePixelRatio);

      QX = W * 0.25; QY = H * 0.65;   // sumber gempa
      SX = W * 0.52; SY = H * 0.32;   // sensor
      PHX = W * 0.80; PHY = H * 0.48; // phone
    }

    function reset() {
      frame = 0; phase = 0; phaseF = 0;
      pRings.length = 0; sRings.length = 0;
      quakePulse = 0; sensorLit = 0;
      signalT = -1; phoneAlert = 0; phoneBuzz = 0;
      sWaveStarted = false;
      warn.style.opacity  = '0';
      progress.style.width = '0%';
      caption.style.opacity = '0';
    }

    /* ---- drawing helpers ---- */

    function drawGrid() {
      ctx.clearRect(0, 0, W, H);
      ctx.fillStyle = '#f8fafc';
      ctx.fillRect(0, 0, W, H);
      ctx.strokeStyle = '#e2e8f0';
      ctx.lineWidth = 0.5;
      for (let x = 0; x < W; x += 30) { ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,H); ctx.stroke(); }
      for (let y = 0; y < H; y += 30) { ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(W,y); ctx.stroke(); }
    }

    function drawQuake() {
      // outer glow
      const g = ctx.createRadialGradient(QX, QY, 0, QX, QY, 36);
      g.addColorStop(0, 'rgba(239,68,68,0.18)');
      g.addColorStop(1, 'rgba(239,68,68,0)');
      ctx.beginPath(); ctx.arc(QX, QY, 36, 0, Math.PI*2);
      ctx.fillStyle = g; ctx.fill();

      // pulse ring
      if (quakePulse > 0) {
        ctx.beginPath(); ctx.arc(QX, QY, 10 + quakePulse * 22, 0, Math.PI*2);
        ctx.strokeStyle = `rgba(239,68,68,${0.6*(1-quakePulse)})`;
        ctx.lineWidth = 2; ctx.stroke();
      }

      ctx.beginPath(); ctx.arc(QX, QY, 10, 0, Math.PI*2);
      ctx.fillStyle = '#ef4444'; ctx.fill();

      ctx.font = 'bold 9px system-ui,sans-serif';
      ctx.fillStyle = '#b91c1c';
      ctx.textAlign = 'center';
      ctx.fillText('Sumber Gempa', QX, QY + 24);
    }

    function drawSensor() {
      const lit = sensorLit;
      const bg  = lit > 0 ? `rgba(59,130,246,${0.08 + lit*0.12})` : 'rgba(241,245,249,1)';
      ctx.beginPath(); ctx.arc(SX, SY, 22, 0, Math.PI*2);
      ctx.fillStyle = bg; ctx.fill();
      ctx.strokeStyle = lit > 0 ? `rgba(59,130,246,${0.5+lit*0.5})` : '#cbd5e1';
      ctx.lineWidth = 1.2; ctx.stroke();

      // inner dot
      ctx.beginPath(); ctx.arc(SX, SY, 6, 0, Math.PI*2);
      ctx.fillStyle = lit > 0 ? `rgba(37,99,235,${0.5+lit*0.5})` : '#94a3b8';
      ctx.fill();

      // lit pulse
      if (lit > 0 && lit < 1) {
        ctx.beginPath(); ctx.arc(SX, SY, 6 + lit * 18, 0, Math.PI*2);
        ctx.strokeStyle = `rgba(59,130,246,${0.5*(1-lit)})`;
        ctx.lineWidth = 1.5; ctx.stroke();
      }

      ctx.font = 'bold 9px system-ui,sans-serif';
      ctx.fillStyle = '#1d4ed8';
      ctx.textAlign = 'center';
      ctx.fillText('Sensor BMKG', SX, SY + 36);
    }

    function drawPhone() {
      const alert = phoneAlert;
      const bx = PHX - 18, by = PHY - 32;
      const bw = 36, bh = 64, br = 8;

      // body
      ctx.beginPath();
      ctx.roundRect(bx, by, bw, bh, br);
      ctx.fillStyle = '#1e293b'; ctx.fill();

      // screen
      const screenColor = alert > 0.5 ? `rgba(239,68,68,${Math.min(alert*1.5,1)})` : '#0f172a';
      ctx.beginPath();
      ctx.roundRect(bx+3, by+4, bw-6, bh-14, 5);
      ctx.fillStyle = screenColor; ctx.fill();

      // alert icon
      if (alert > 0.4) {
        ctx.font = `bold ${9+alert*4}px system-ui,sans-serif`;
        ctx.fillStyle = `rgba(255,255,255,${Math.min((alert-0.4)*3,1)})`;
        ctx.textAlign = 'center';
        ctx.fillText('!', PHX, PHY + 2);
        if (alert > 0.7) {
          ctx.font = 'bold 6px system-ui,sans-serif';
          ctx.fillStyle = `rgba(255,255,255,${(alert-0.7)*3})`;
          ctx.fillText('ALERT', PHX, PHY + 11);
        }
      }

      // home bar
      ctx.beginPath();
      ctx.roundRect(PHX-8, by+bh-8, 16, 3, 2);
      ctx.fillStyle = '#334155'; ctx.fill();

      // buzz shake
      if (phoneBuzz > 0) {
        const shake = Math.sin(phoneBuzz * Math.PI * 8) * 3 * phoneBuzz;
        ctx.save();
        ctx.translate(shake, 0);
      }

      ctx.font = 'bold 9px system-ui,sans-serif';
      ctx.fillStyle = '#64748b';
      ctx.textAlign = 'center';
      ctx.fillText('Pengguna', PHX, by + bh + 16);

      if (phoneBuzz > 0) ctx.restore();
    }

    function drawPRings() {
      const distSensor = Math.hypot(SX - QX, SY - QY);
      pRings.forEach(r => {
        if (r.a <= 0) return;
        // keep opacity higher when near sensor distance
        let alpha = r.a;
        if (r.r >= distSensor - 10 && r.r <= distSensor + 30) {
          alpha = Math.max(alpha, 0.55); // boost at sensor
        }
        ctx.beginPath(); ctx.arc(QX, QY, r.r, 0, Math.PI*2);
        ctx.strokeStyle = `rgba(59,130,246,${alpha})`;
        ctx.lineWidth = 2;
        ctx.setLineDash([8, 5]);
        ctx.stroke();
        ctx.setLineDash([]);
      });
    }

    function drawSRings() {
      sRings.forEach(r => {
        if (r.a <= 0) return;
        ctx.beginPath(); ctx.arc(QX, QY, r.r, 0, Math.PI*2);
        ctx.strokeStyle = `rgba(239,68,68,${r.a})`;
        ctx.lineWidth = 3.5;
        ctx.stroke();
      });
    }

    function drawSignal() {
      if (signalT < 0) return;
      const t = Math.min(signalT, 1);
      const ex = SX + (PHX - SX) * t;
      const ey = SY + (PHY - SY) * t;

      ctx.beginPath(); ctx.moveTo(SX, SY); ctx.lineTo(ex, ey);
      ctx.strokeStyle = 'rgba(220,38,38,0.65)';
      ctx.lineWidth = 1.5;
      ctx.setLineDash([6, 4]);
      ctx.stroke();
      ctx.setLineDash([]);

      // moving dot
      if (t < 1) {
        ctx.beginPath(); ctx.arc(ex, ey, 4, 0, Math.PI*2);
        ctx.fillStyle = '#dc2626'; ctx.fill();
        // glow
        ctx.beginPath(); ctx.arc(ex, ey, 8, 0, Math.PI*2);
        ctx.fillStyle = 'rgba(220,38,38,0.2)'; ctx.fill();
      }
    }

    function drawLegend() {
      const lx = 14, ly = H - 44;
      ctx.font = '600 9px system-ui,sans-serif';
      ctx.textAlign = 'left';

      ctx.beginPath(); ctx.arc(lx+5, ly+5, 5, 0, Math.PI*2);
      ctx.fillStyle = '#3b82f6'; ctx.fill();
      ctx.fillStyle = '#475569'; ctx.fillText('Gelombang P (cepat)', lx+14, ly+9);

      ctx.beginPath(); ctx.arc(lx+5, ly+20, 5, 0, Math.PI*2);
      ctx.fillStyle = '#ef4444'; ctx.fill();
      ctx.fillStyle = '#475569'; ctx.fillText('Gelombang S (lambat, kuat)', lx+14, ly+24);
    }

    /* ---- main tick ---- */

    function tick() {
      if (!running) return;
      frame++;
      phaseF++;

      const totalF = PHASES.reduce((s, p) => s + p.frames, 0);
      progress.style.width = (Math.min(frame / totalF, 1) * 100).toFixed(1) + '%';

      // quake pulse always
      quakePulse = (Math.sin(frame * 0.12) + 1) / 2;

      // Phase logic
      if (phase === 0) {
        // just quake
        if (phaseF >= PHASES[0].frames) nextPhase();
      }

      else if (phase === 1) {
        // P waves emit — speed matched so rings visibly reach sensor
        if (phaseF % 28 === 1) pRings.push({ r: 5, a: 0.85 });
        const distSensor = Math.hypot(SX - QX, SY - QY);
        pRings.forEach(r => {
          r.r += 1.4;
          // fade slowly — ring must still be visible at sensor distance
          r.a -= (0.85 / (distSensor / 1.4 + 40));
        });
        // trigger next phase once first ring reaches sensor
        const firstAlive = pRings.find(r => r.a > 0);
        if (firstAlive && firstAlive.r >= distSensor) nextPhase();
        else if (phaseF >= PHASES[1].frames) nextPhase();
      }

      else if (phase === 2) {
        // P wave AT sensor — light it up
        const distSensor = Math.hypot(SX - QX, SY - QY);
        pRings.forEach(r => {
          r.r += 1.4;
          r.a -= (0.85 / (distSensor / 1.4 + 40));
        });
        sensorLit = Math.min(phaseF / 25, 1);
        if (phaseF >= PHASES[2].frames) nextPhase();
      }

      else if (phase === 3) {
        // signal travels to phone
        const dS3 = Math.hypot(SX - QX, SY - QY);
        pRings.forEach(r => { r.r += 1.4; r.a -= (0.85 / (dS3 / 1.4 + 40)); });
        if (signalT < 0) signalT = 0;
        signalT += 0.02;
        if (signalT >= 1) {
          phoneAlert = Math.min(phoneAlert + 0.06, 1);
          if (phoneAlert > 0.5 && warn.style.opacity === '0') {
            warn.style.opacity = '1';
          }
          if (phoneAlert > 0.6 && phoneBuzz < 1) {
            phoneBuzz = Math.max(0, 1 - (phoneAlert - 0.6) * 5);
          }
        }
        if (phaseF >= PHASES[3].frames) nextPhase();
      }

      else if (phase === 4) {
        // S waves emit — must visibly reach phone
        const distPhone = Math.hypot(PHX - QX, PHY - QY);
        const sSpeed = 0.95;
        pRings.forEach(r => { r.r += 1.3; r.a -= 0.015; });
        if (!sWaveStarted || phaseF % 40 === 1) {
          sRings.push({ r: 5, a: 0.9 });
          sWaveStarted = true;
        }
        sRings.forEach(r => {
          r.r += sSpeed;
          r.a -= (0.9 / (distPhone / sSpeed + 40));
        });
        phoneBuzz = Math.max(0, phoneBuzz - 0.05);
        // advance once first S ring reaches phone
        const firstS = sRings.find(r => r.a > 0);
        if (firstS && firstS.r >= distPhone) nextPhase();
        else if (phaseF >= PHASES[4].frames) nextPhase();
      }

      else if (phase === 5) {
        pRings.forEach(r => { r.r += 1.2; r.a -= 0.018; });
        sRings.forEach(r => { r.r += 0.9; r.a -= 0.009; });
        if (phaseF >= PHASES[5].frames) {
          running = false;
          btnIcon.textContent = 'replay';
          btn.style.opacity = '1';
          btn.style.cursor = 'pointer';
          caption.style.opacity = '0';
          return;
        }
      }

      // draw
      drawGrid();
      drawPRings();
      drawSRings();
      drawSignal();
      drawSensor();
      drawPhone();
      drawQuake();
      drawLegend();

      raf = requestAnimationFrame(tick);
    }

    function nextPhase() {
      phase++;
      phaseF = 0;
      if (phase < PHASES.length) {
        caption.textContent = PHASES[phase].caption;
        caption.style.opacity = '1';
        setTimeout(() => { if (phase < PHASES.length - 1) caption.style.opacity = '0.7'; }, 1800);
      }
    }

    function start() {
      if (running) return;
      if (raf) cancelAnimationFrame(raf);
      reset();
      resize();
      running = true;
      btnIcon.textContent = 'stop';
      btn.style.opacity = '0.5';
      btn.style.cursor = 'default';
      caption.textContent = PHASES[0].caption;
      caption.style.opacity = '1';
      raf = requestAnimationFrame(tick);
    }

    window._inaeewsStart = start;
    window.addEventListener('resize', () => { if (!running) { resize(); drawGrid(); drawSensor(); drawQuake(); drawLegend(); } });
    resize();
    drawGrid();
    drawSensor();
    drawQuake();
    drawLegend();

    // auto-play on scroll into view
    const observer = new IntersectionObserver(entries => {
      entries.forEach(e => { if (e.isIntersecting && frame === 0) start(); });
    }, { threshold: 0.4 });
    observer.observe(panel);
  }

  if (document.readyState === 'complete') initInaEEWS();
  else window.addEventListener('load', initInaEEWS);
})();
</script>

<style>
  svg text { font-family: inherit; pointer-events: none; user-select: none; }
</style>