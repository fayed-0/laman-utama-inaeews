---
import eyeIcon from '../../../assets/eye.svg';
import downloadIcon from '../../../assets/download.svg';

// Journal entries with varied content
const allJournals = [
  {
    id: 1,
    title: "Real-Time Seismic Processing for Earthquake Early Warning in Indonesia",
    description: "Penelitian komprehensif tentang pemrosesan data seismik real-time untuk sistem peringatan dini gempa bumi. Fokus pada akselerasi deteksi dan akurasi prediksi dengan teknologi terkini di BMKG...",
    tags: ["BMKG Technical Report", "2025", "EN"],
    author: "Hidayat et al., 2025 — BMKG Research Division"
  },
  {
    id: 2,
    title: "Machine Learning Models for Earthquake Magnitude Prediction",
    description: "Implementasi algoritma machine learning untuk prediksi magnitudo gempa dengan akurasi tinggi. Penelitian menggunakan neural network dan ensemble learning untuk validasi optimal...",
    tags: ["Research Paper", "2025", "ID"],
    author: "Sutrisno et al., 2025 — ITB Seismology Lab"
  },
  {
    id: 3,
    title: "Seismic Network Density and EEW System Effectiveness",
    description: "Analisis pengaruh kepadatan jaringan seismik terhadap efektivitas sistem peringatan dini gempa. Studi kasus dilakukan di Jawa dan Sumatera dengan perbandingan konfigurasi jaringan berbeda...",
    tags: ["Conference Paper", "2024", "EN"],
    author: "Wulandari et al., 2024 — Univ. of Indonesia"
  },
  {
    id: 4,
    title: "Urban Earthquake Risk Assessment and Mitigation Strategies",
    description: "Evaluasi risiko gempa di area urban padat penduduk dengan strategi mitigasi bencana inovatif. Studi mencakup analisis kerentanan infrastruktur di Jakarta, Surabaya, dan Bandung...",
    tags: ["Disaster Management", "2024", "ID"],
    author: "Rahman & Kusuma, 2024 — LIPI Jakarta"
  },
  {
    id: 5,
    title: "Ground Motion Characterization in Soft Soil Regions",
    description: "Karakterisasi gerakan tanah di daerah tanah lembut Indonesia untuk analisis respons seismic akurat. Metodologi lapangan melibatkan boring dan pengujian laboratorium di berbagai kedalaman...",
    tags: ["Technical Study", "2025", "EN"],
    author: "Santoso et al., 2025 — Pusat Vulkanologi"
  },
  {
    id: 6,
    title: "Community Response to Earthquake Early Warning Alerts",
    description: "Studi perilaku masyarakat terhadap penerimaan peringatan dini gempa dan rencana evakuasi. Penelitian melibatkan 5000+ responden dari berbagai kalangan di kota-kota besar...",
    tags: ["Social Research", "2024", "ID"],
    author: "Permata & Wijaya, 2024 — BNPB Research"
  },
  {
    id: 7,
    title: "Tsunami Hazard Assessment and Warning System Integration",
    description: "Evaluasi komprehensif tentang potensi bahaya tsunami dan integrasi dengan sistem peringatan dini gempa di wilayah pantai Indonesia...",
    tags: ["Technical Report", "2025", "EN"],
    author: "Suwanda et al., 2025 — BMKG Jakarta"
  },
  {
    id: 8,
    title: "Building Code Compliance and Earthquake Resilience",
    description: "Studi ketaatan standar bangunan terhadap gempa dan efektivitasnya dalam meningkatkan ketangguhan infrastruktur perkotaan...",
    tags: ["Research Paper", "2024", "ID"],
    author: "Wijoto & Hartono, 2024 — ITB Engineering"
  },
  {
    id: 9,
    title: "Digital Transformation in Seismic Monitoring Networks",
    description: "Implementasi teknologi digital dan IoT dalam modernisasi jaringan pemantauan seismik Indonesia untuk efisiensi dan akurasi lebih baik...",
    tags: ["Conference Paper", "2025", "EN"],
    author: "Pratama et al., 2025 — BPPT Research"
  }
];

const itemsPerPage = 5;
const sortOptions = [
  { value: "terbaru", label: "TERBARU" },
  { value: "terlama", label: "TERLAMA" },
  { value: "az", label: "JUDUL A-Z" },
  { value: "za", label: "JUDUL Z-A" },
];
---

<section class="snap-start w-full bg-white py-24 px-12 md:px-24 overflow-hidden">
  <div class="max-w-7xl mx-auto flex flex-col gap-12">
    <!-- Header -->
    <div class="flex flex-col items-center gap-3">
      <h2 class="text-center text-4xl font-bold">
        <span class="text-slate-800">Jurnal &amp; </span>
        <span class="text-blue-600">Referensi Ilmiah</span>
      </h2>
      <p class="text-center text-slate-400 text-base max-w-2xl">
        Kumpulan jurnal ilmiah seputar sistem peringatan dini gempa bumi Indonesia dan mitigasi bencana.
      </p>
    </div>

    <!-- Filter and Sort Section -->
    <div class="relative flex items-center w-full">
      <!-- Sort Dropdown -->
      <div class="relative flex-shrink-0" id="sortDropdownWrapper">
        <button
          type="button"
          id="sortDropdownBtn"
          class="flex items-center gap-2 px-4 py-2 rounded-lg border border-slate-400 text-slate-700 text-sm font-bold uppercase tracking-wider hover:bg-slate-50 transition-colors whitespace-nowrap"
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          <span id="sortDropdownLabel">TERBARU</span>
          <svg id="sortDropdownIcon" class="w-4 h-4 transition-transform" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div
          id="sortDropdownMenu"
          class="hidden absolute left-0 top-full mt-2 w-44 bg-white rounded-lg border border-slate-200 shadow-lg overflow-hidden z-20"
          role="listbox"
        >
          {sortOptions.map((opt) => (
            <button
              type="button"
              class="sort-option w-full text-left px-4 py-2.5 text-sm font-semibold uppercase tracking-wider text-slate-700 hover:bg-blue-50 hover:text-blue-600 transition-colors"
              data-value={opt.value}
            >
              {opt.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Search -->
      <div
        id="searchWrapper"
        class="ml-auto h-8 px-4 py-1 rounded-full border border-slate-400 focus-within:border-blue-500 inline-flex items-center gap-2 overflow-hidden hover:border-slate-500 transition-[width] duration-300 ease-in-out flex-shrink-0"
      >
        <input
          type="text"
          id="journalSearchInput"
          placeholder="SEARCH"
          class="flex-1 min-w-0 bg-transparent outline-none text-slate-700 text-xs font-bold uppercase leading-4 tracking-wider placeholder-slate-400"
        />
        <button type="button" id="journalSearchBtn" class="w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 hover:bg-slate-100 transition-colors">
          <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Result count -->
    <p id="journalResultCount" class="text-xs text-slate-400 -mt-8"></p>

    <!-- Journals Grid -->
    <div class="space-y-4" id="journalsGrid">
      {allJournals.slice(0, itemsPerPage).map((journal) => (
        <div class="bg-white rounded-2xl shadow-md border border-slate-100 overflow-hidden hover:shadow-lg transition-shadow p-6">
          <div class="space-y-4">
            <!-- Title -->
            <h3 class="text-slate-800 font-bold text-xl leading-tight">
              {journal.title}
            </h3>
            
            <!-- Tags -->
            <div class="flex flex-wrap gap-2">
              {journal.tags.map((tag) => {
                let bgColor = "bg-blue-50 border-blue-200 text-blue-600";
                if (tag === "2024" || tag.includes("2024")) bgColor = "bg-orange-100 border-orange-200 text-orange-600";
                if (tag === "EN" || tag === "ID") bgColor = "bg-green-100 border-green-200 text-green-700";
                if (tag.includes("Social") || tag.includes("Social Research")) bgColor = "bg-purple-100 border-purple-200 text-purple-600";
                if (tag.includes("Conference") || tag.includes("Research Paper")) bgColor = "bg-amber-100 border-amber-200 text-amber-700";
                return (
                  <span class={`inline-flex items-center px-3 py-1 rounded-full border text-xs font-bold uppercase tracking-wider ${bgColor}`}>
                    {tag}
                  </span>
                );
              })}
            </div>

            <!-- Description -->
            <p class="text-slate-600 text-xs leading-relaxed line-clamp-3">
              {journal.description}
            </p>

            <!-- Divider -->
            <div class="border-t border-slate-200"></div>

            <!-- Author & Actions -->
            <div class="flex items-center justify-between pt-2">
              <span class="text-slate-500 text-xs">{journal.author}</span>
              <div class="flex gap-2">
                <button class="p-1 rounded hover:bg-slate-100 transition-colors" title="View">
                  <img src={eyeIcon.src} alt="View" class="w-5 h-5" />
                </button>
                <button class="p-1 rounded hover:bg-slate-100 transition-colors bg-blue-50" title="Download">
                  <img src={downloadIcon.src} alt="Download" class="w-5 h-5" />
                </button>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Empty state -->
    <div id="journalEmptyState" class="hidden flex-col items-center justify-center py-12 text-center">
      <p class="text-slate-500 text-base">Tidak ada jurnal yang cocok dengan pencarian Anda.</p>
    </div>

    <!-- Pagination -->
    <div class="flex items-center justify-end gap-2" id="journalPaginationWrapper">
      <button class="p-2 text-slate-600 hover:text-slate-900 transition-colors" id="prevBtn">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>

      <div class="flex items-center gap-1" id="paginationContainer">
        {Array.from({ length: Math.ceil(allJournals.length / itemsPerPage) }).map((_, index) => (
          <button
            class={`w-8 h-8 rounded text-sm font-bold transition-colors ${
              index === 0
                ? "bg-blue-600 text-white"
                : "bg-slate-100 text-slate-700 hover:bg-slate-200"
            }`}
            data-page={index + 1}
          >
            {index + 1}
          </button>
        ))}
      </div>

      <button class="p-2 text-slate-600 hover:text-slate-900 transition-colors" id="nextBtn">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
    </div>
  </div>
</section>

<script define:vars={{ allJournals, itemsPerPage }}>
  let currentPage = 1;
  let searchQuery = '';
  let sortValue = 'terbaru';
  let filteredJournals = [...allJournals];

  const journalsGrid = document.getElementById('journalsGrid');
  const paginationContainer = document.getElementById('paginationContainer');
  const paginationWrapper = document.getElementById('journalPaginationWrapper');
  const emptyState = document.getElementById('journalEmptyState');
  const resultCount = document.getElementById('journalResultCount');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');

  const searchInput = document.getElementById('journalSearchInput');
  const searchBtn = document.getElementById('journalSearchBtn');
  const searchWrapper = document.getElementById('searchWrapper');

  const sortDropdownWrapper = document.getElementById('sortDropdownWrapper');
  const sortDropdownBtn = document.getElementById('sortDropdownBtn');
  const sortDropdownMenu = document.getElementById('sortDropdownMenu');
  const sortDropdownLabel = document.getElementById('sortDropdownLabel');
  const sortDropdownIcon = document.getElementById('sortDropdownIcon');

  // --- Search box sizing: matches the sort button's width by default,
  // and expands a bit wider when focused/clicked ---
  function syncSearchWidth() {
    const baseWidth = sortDropdownBtn.offsetWidth;
    searchWrapper.dataset.baseWidth = baseWidth;
    if (document.activeElement !== searchInput) {
      searchWrapper.style.width = baseWidth + 'px';
    }
  }
  syncSearchWidth();
  window.addEventListener('resize', syncSearchWidth);

  searchInput.addEventListener('focus', () => {
    const baseWidth = parseInt(searchWrapper.dataset.baseWidth || '128', 10);
    searchWrapper.style.width = (baseWidth + 96) + 'px';
  });

  searchInput.addEventListener('blur', () => {
    if (searchInput.value.trim() === '') {
      const baseWidth = parseInt(searchWrapper.dataset.baseWidth || '128', 10);
      searchWrapper.style.width = baseWidth + 'px';
    }
  });

  function getYear(journal) {
    const yearTag = journal.tags.find((t) => /^\d{4}$/.test(t));
    return yearTag ? parseInt(yearTag, 10) : 0;
  }

  function applySort(list) {
    const sorted = [...list];
    switch (sortValue) {
      case 'terbaru':
        sorted.sort((a, b) => getYear(b) - getYear(a) || b.id - a.id);
        break;
      case 'terlama':
        sorted.sort((a, b) => getYear(a) - getYear(b) || a.id - b.id);
        break;
      case 'az':
        sorted.sort((a, b) => a.title.localeCompare(b.title));
        break;
      case 'za':
        sorted.sort((a, b) => b.title.localeCompare(a.title));
        break;
    }
    return sorted;
  }

  function applyFilters() {
    const query = searchQuery.trim().toLowerCase();

    let result = allJournals.filter((journal) => {
      if (query === '') return true;
      const haystack = [
        journal.title,
        journal.description,
        journal.author,
        ...journal.tags,
      ].join(' ').toLowerCase();
      return haystack.includes(query);
    });

    result = applySort(result);
    filteredJournals = result;
    currentPage = 1;
    renderJournals();
    renderPagination();
    updateResultCount();
  }

  function updateResultCount() {
    if (!resultCount) return;
    if (searchQuery.trim() === '') {
      resultCount.textContent = `Menampilkan semua ${allJournals.length} jurnal`;
    } else {
      resultCount.textContent = `Ditemukan ${filteredJournals.length} dari ${allJournals.length} jurnal`;
    }
  }

  function renderJournals() {
    if (filteredJournals.length === 0) {
      journalsGrid.classList.add('hidden');
      paginationWrapper.classList.add('hidden');
      emptyState.classList.remove('hidden');
      emptyState.classList.add('flex');
      return;
    } else {
      journalsGrid.classList.remove('hidden');
      paginationWrapper.classList.remove('hidden');
      emptyState.classList.add('hidden');
      emptyState.classList.remove('flex');
    }

    const start = (currentPage - 1) * itemsPerPage;
    const end = start + itemsPerPage;
    const paginatedJournals = filteredJournals.slice(start, end);

    journalsGrid.innerHTML = paginatedJournals.map(journal => `
      <div class="bg-white rounded-2xl shadow-md border border-slate-100 overflow-hidden hover:shadow-lg transition-shadow p-6">
        <div class="space-y-4">
          <!-- Title -->
          <h3 class="text-slate-800 font-bold text-xl leading-tight">
            ${journal.title}
          </h3>
          
          <!-- Tags -->
          <div class="flex flex-wrap gap-2">
            ${journal.tags.map((tag) => {
              let bgColor = "bg-blue-50 border-blue-200 text-blue-600";
              if (tag === "2024" || tag.includes("2024")) bgColor = "bg-orange-100 border-orange-200 text-orange-600";
              if (tag === "EN" || tag === "ID") bgColor = "bg-green-100 border-green-200 text-green-700";
              if (tag.includes("Social") || tag.includes("Social Research")) bgColor = "bg-purple-100 border-purple-200 text-purple-600";
              if (tag.includes("Conference") || tag.includes("Research Paper")) bgColor = "bg-amber-100 border-amber-200 text-amber-700";
              return `<span class="inline-flex items-center px-3 py-1 rounded-full border text-xs font-bold uppercase tracking-wider ${bgColor}">${tag}</span>`;
            }).join('')}
          </div>

          <!-- Description -->
          <p class="text-slate-600 text-xs leading-relaxed line-clamp-3">
            ${journal.description}
          </p>

          <!-- Divider -->
          <div class="border-t border-slate-200"></div>

          <!-- Author & Actions -->
          <div class="flex items-center justify-between pt-2">
            <span class="text-slate-500 text-xs">${journal.author}</span>
            <div class="flex gap-2">
              <button class="p-1 rounded hover:bg-slate-100 transition-colors" title="View">
                <svg class="w-5 h-5" width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M9.375 7.5C9.375 7.99728 9.17746 8.47419 8.82583 8.82583C8.47419 9.17746 7.99728 9.375 7.5 9.375C7.00272 9.375 6.52581 9.17746 6.17417 8.82583C5.82254 8.47419 5.625 7.99728 5.625 7.5C5.625 7.00272 5.82254 6.52581 6.17417 6.17417C6.52581 5.82254 7.00272 5.625 7.5 5.625C7.99728 5.625 8.47419 5.82254 8.82583 6.17417C9.17746 6.52581 9.375 7.00272 9.375 7.5Z" stroke="#94A3B8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M1.25 7.5C2.25 4.93937 4.585 3.125 7.5 3.125C10.415 3.125 12.75 4.93937 13.75 7.5C12.75 10.0606 10.415 11.875 7.5 11.875C4.585 11.875 2.25 10.0606 1.25 7.5Z" stroke="#94A3B8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <button class="p-1 rounded hover:bg-slate-100 transition-colors bg-blue-50" title="Download">
                <svg class="w-5 h-5" width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M2.5 10.0025V10.625C2.5 11.1223 2.69754 11.5992 3.04917 11.9508C3.40081 12.3025 3.87772 12.5 4.375 12.5H10.625C11.1223 12.5 11.5992 12.3025 11.9508 11.9508C12.3025 11.5992 12.5 11.1223 12.5 10.625V10M7.5 2.8125V9.6875M7.5 9.6875L9.6875 7.5M7.5 9.6875L5.3125 7.5" stroke="#94A3B8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    `).join('');
  }

  function renderPagination() {
    const totalPages = Math.ceil(filteredJournals.length / itemsPerPage);
    paginationContainer.innerHTML = '';

    // Show page numbers with ellipsis
    let startPage = Math.max(1, currentPage - 1);
    let endPage = Math.min(totalPages, currentPage + 1);

    if (currentPage <= 2) {
      endPage = Math.min(totalPages, 3);
    }
    if (currentPage > totalPages - 2) {
      startPage = Math.max(1, totalPages - 2);
    }

    // Previous ellipsis
    if (startPage > 1) {
      const prevEllipsis = document.createElement('span');
      prevEllipsis.textContent = '...';
      prevEllipsis.className = 'text-slate-400';
      paginationContainer.appendChild(prevEllipsis);
    }

    // Page numbers
    for (let i = startPage; i <= endPage; i++) {
      const btn = document.createElement('button');
      btn.className = `w-8 h-8 rounded text-sm font-bold transition-colors ${
        i === currentPage
          ? 'bg-blue-600 text-white'
          : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
      }`;
      btn.textContent = i;
      btn.setAttribute('data-page', i);
      btn.addEventListener('click', () => {
        currentPage = i;
        renderJournals();
        renderPagination();
      });
      paginationContainer.appendChild(btn);
    }

    // Next ellipsis
    if (endPage < totalPages) {
      const nextEllipsis = document.createElement('span');
      nextEllipsis.textContent = '...';
      nextEllipsis.className = 'text-slate-400';
      paginationContainer.appendChild(nextEllipsis);
    }

    // Update prev/next buttons
    prevBtn.disabled = currentPage === 1;
    nextBtn.disabled = currentPage === totalPages;
    prevBtn.style.opacity = currentPage === 1 ? '0.5' : '1';
    nextBtn.style.opacity = currentPage === totalPages ? '0.5' : '1';
  }

  prevBtn.addEventListener('click', () => {
    if (currentPage > 1) {
      currentPage--;
      renderJournals();
      renderPagination();
    }
  });

  nextBtn.addEventListener('click', () => {
    const totalPages = Math.ceil(filteredJournals.length / itemsPerPage);
    if (currentPage < totalPages) {
      currentPage++;
      renderJournals();
      renderPagination();
    }
  });

  // --- Search ---
  let searchDebounce;
  searchInput.addEventListener('input', (e) => {
    clearTimeout(searchDebounce);
    const value = e.target.value;
    searchDebounce = setTimeout(() => {
      searchQuery = value;
      applyFilters();
    }, 200);
  });

  searchInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      clearTimeout(searchDebounce);
      searchQuery = searchInput.value;
      applyFilters();
    }
  });

  searchBtn.addEventListener('click', () => {
    clearTimeout(searchDebounce);
    searchQuery = searchInput.value;
    applyFilters();
    searchInput.focus();
  });

  // --- Sort dropdown ---
  function closeSortDropdown() {
    sortDropdownMenu.classList.add('hidden');
    sortDropdownBtn.setAttribute('aria-expanded', 'false');
    sortDropdownIcon.style.transform = 'rotate(0deg)';
  }

  function openSortDropdown() {
    sortDropdownMenu.classList.remove('hidden');
    sortDropdownBtn.setAttribute('aria-expanded', 'true');
    sortDropdownIcon.style.transform = 'rotate(180deg)';
  }

  sortDropdownBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = !sortDropdownMenu.classList.contains('hidden');
    if (isOpen) {
      closeSortDropdown();
    } else {
      openSortDropdown();
    }
  });

  document.querySelectorAll('.sort-option').forEach((option) => {
    option.addEventListener('click', () => {
      sortValue = option.getAttribute('data-value');
      sortDropdownLabel.textContent = option.textContent.trim();
      closeSortDropdown();
      syncSearchWidth();
      applyFilters();
    });
  });

  document.addEventListener('click', (e) => {
    if (!sortDropdownWrapper.contains(e.target)) {
      closeSortDropdown();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeSortDropdown();
    }
  });

  // Initialize
  filteredJournals = applySort(allJournals);
  renderJournals();
  renderPagination();
  updateResultCount();
</script>