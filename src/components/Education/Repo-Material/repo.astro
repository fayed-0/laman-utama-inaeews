---
// src/pages/education/materials/repo.astro
//
// Halaman preview materi (PDF) + rekomendasi terkait.
// Route ini STATIS (/education/materials/repo), jadi materi yang
// ditampilkan langsung di-hardcode ke "materi-eews" (lihat bawah).

import eyeIcon from '../../../assets/eye.svg';
import downloadIcon from '../../../assets/download.svg';
import pageIcon from '../../../assets/page.svg';

// --- PDF asset ---
import materiEewsPdf from '../../../assets/Modul/materi-eews.pdf?url';

// --- Data materi (idealnya di-import dari file data bersama) ---
const allMaterials = [
  {
    id: 1,
    title: "Gelombang P-Wave dan S-Wave",
