    description: "Analisis mendalam tentang berbagai jenis gelombang seismik dan dampaknya terhadap struktur bangunan dan infrastruktur...",
    tag: "Teknis",
    color: "bg-blue-600",
    pages: 18,
    category: "MODUL",
    link: "https://web-meteo.bmkg.go.id/id/peringatan/informasi-khusus-bibit-dan-siklon-tropis",
  },
  {
    id: 11,
    title: "Panduan Evakuasi Cepat",
    description: "Protokol evakuasi darurat yang terstruktur untuk berbagai skenario bencana gempa dan tsunami di wilayah pantai...",
    tag: "Panduan",
    color: "bg-green-700",
    pages: 8,
    category: "PANDUAN",
    link: "https://web-meteo.bmkg.go.id/id/peringatan/informasi-khusus-bibit-dan-siklon-tropis",
  },
  {
    id: 12,
    title: "Data Historis Gempa Indonesia",
    description: "Kumpulan data lengkap gempa yang terjadi di Indonesia dalam 50 tahun terakhir dengan analisis pola dan tren...",
    tag: "Teknis",
    color: "bg-slate-700",
    pages: 30,
    category: "MODUL",
    link: "https://web-meteo.bmkg.go.id/id/peringatan/informasi-khusus-bibit-dan-siklon-tropis",
  },
  {
    id: 13,
    slug: "materi-eews",
    title: "Materi EEWS: Sistem Peringatan Dini Gempa Bumi Indonesia",
    description: "Modul lengkap tentang cara kerja InaEEWS, mulai dari deteksi sensor, pemrosesan data, hingga penyebaran peringatan dini ke masyarakat dalam hitungan detik.",
    tag: "Modul",
    color: "bg-blue-700",
    pages: 16,
    category: "MODUL",
    author: "Tim InaEEWS — BMKG",
    publishedAt: "2026",
    fileUrl: materiEewsPdf,
  },
];

// --- Resolusi materi aktif ---
// Halaman ini route-nya statis (/education/materials/repo), bukan dynamic
// route [id], jadi TIDAK bisa mengandalkan Astro.params untuk menentukan
// materi mana yang ditampilkan — di route statis, Astro.params selalu kosong.
// Karena itu materinya di-hardcode langsung ke "materi-eews".
//
// Kalau nanti kamu mau halaman ini dinamis lagi (beda materi per URL),
// rename file ke `[id].astro` dan kembalikan baris di bawah ini:
//   const { id } = Astro.params;
//   const material = allMaterials.find((m) => String(m.id) === String(id) || m.slug === id)
//     ?? allMaterials.find((m) => m.slug === "materi-eews");
const material = allMaterials.find((m) => m.slug === "materi-eews");

// --- Rekomendasi terkait: kategori/tag sama, exclude diri sendiri, max 3 ---
const related = allMaterials
  .filter((m) => m.id !== material.id)
  .sort((a, b) => {
    const aScore = (a.category === material.category ? 2 : 0) + (a.tag === material.tag ? 1 : 0);
    const bScore = (b.category === material.category ? 2 : 0) + (b.tag === material.tag ? 1 : 0);
    return bScore - aScore;
  })
  .slice(0, 3);

const pdfSrc = material.fileUrl ?? material.link;
const isPdf = Boolean(material.fileUrl);
---

<section class="w-full bg-white py-16 md:py-24 px-6 md:px-12 lg:px-24">
    <div class="max-w-7xl mx-auto flex flex-col gap-10">

      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-slate-400">
        <a href="/education" class="hover:text-blue-600 transition-colors">Materi Edukasi</a>
        <span>/</span>
        <a href="/education/materials" class="hover:text-blue-600 transition-colors">Materi &amp; Infografis</a>
        <span>/</span>
        <span class="text-blue-600 truncate max-w-[240px]">{material.title}</span>
      </nav>

      <!-- Header: back link -->
      <a
        href="/education/materials"
        class="inline-flex items-center gap-2 text-sm font-bold text-slate-600 hover:text-blue-600 transition-colors w-fit"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Kembali ke Materi &amp; Infografis
      </a>

      <!-- Main grid: preview (left) + info panel (right) -->
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-8 items-start">

        <!-- PDF Preview -->
        <div class="flex flex-col gap-4">
          <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-md bg-slate-50">
            <div class={`h-3 ${material.color}`}></div>
            {isPdf ? (
              <object
                data={pdfSrc}
                type="application/pdf"
                class="w-full"
                style="height: 78vh; min-height: 480px;"
              >
                <div class="w-full h-[480px] flex flex-col items-center justify-center gap-4 p-8 text-center">
                  <img src={pageIcon.src} alt="PDF" class="w-10 h-10 opacity-60" />
                  <p class="text-slate-600 text-sm max-w-sm">
                    Pratinjau PDF tidak dapat ditampilkan langsung di perangkat ini.
                    Silakan buka atau unduh file untuk melihat isi lengkapnya.
                  </p>
                  <a
                    href={pdfSrc}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-5 py-2 rounded-full bg-blue-600 text-white text-xs font-bold uppercase tracking-wider hover:bg-blue-700 transition-colors"
                  >
                    Buka PDF
                  </a>
                </div>
              </object>
            ) : (
              <div class="w-full h-[480px] flex flex-col items-center justify-center gap-4 p-8 text-center">
                <img src={pageIcon.src} alt="Dokumen" class="w-10 h-10 opacity-60" />
                <p class="text-slate-600 text-sm max-w-sm">
                  Materi ini tersedia melalui tautan eksternal.
                </p>
                <a
                  href={pdfSrc}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-5 py-2 rounded-full bg-blue-600 text-white text-xs font-bold uppercase tracking-wider hover:bg-blue-700 transition-colors"
                >
                  Buka Tautan
                </a>
              </div>
            )}
          </div>

          <!-- Deskripsi lengkap -->
          <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 flex flex-col gap-3">
            <h2 class="text-slate-800 font-bold text-lg">Tentang Materi Ini</h2>
            <p class="text-slate-600 text-sm leading-relaxed">
              {material.description}
            </p>
          </div>
        </div>

        <!-- Info / Action panel -->
        <aside class="flex flex-col gap-5 w-full lg:w-[360px] flex-shrink-0 self-start">
          <div class="bg-white rounded-2xl border border-slate-100 shadow-md overflow-hidden">
            <div class={`h-28 ${material.color} relative`}>
              <span class="absolute bottom-3 left-5 inline-block px-3 py-1 rounded-full bg-white/90 text-slate-800 text-xs font-bold uppercase tracking-wider">
                {material.tag}
              </span>
            </div>
            <div class="p-6 flex flex-col gap-4">
              <h1 class="text-slate-800 font-bold text-xl leading-snug">
                {material.title}
              </h1>

              <div class="flex flex-col gap-2 text-sm text-slate-600 border-t border-slate-100 pt-4">
                <div class="flex items-center justify-between">
                  <span class="text-slate-400 font-semibold uppercase text-xs tracking-wider">Kategori</span>
                  <span class="font-semibold">{material.category}</span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-slate-400 font-semibold uppercase text-xs tracking-wider">Halaman</span>
                  <span class="font-semibold flex items-center gap-1.5">
                    <img src={pageIcon.src} alt="Pages" class="w-3.5 h-3.5" />
                    {material.pages} halaman
                  </span>
                </div>
                {material.author && (
                  <div class="flex items-center justify-between">
                    <span class="text-slate-400 font-semibold uppercase text-xs tracking-wider">Penulis</span>
                    <span class="font-semibold text-right">{material.author}</span>
                  </div>
                )}
                {material.publishedAt && (
                  <div class="flex items-center justify-between">
                    <span class="text-slate-400 font-semibold uppercase text-xs tracking-wider">Tahun</span>
                    <span class="font-semibold">{material.publishedAt}</span>
                  </div>
                )}
              </div>

              <div class="flex flex-col gap-2 pt-2">
                <a
                  href={pdfSrc}
                  download
                  class="flex items-center justify-center gap-2 w-full py-2.5 rounded-full bg-blue-600 text-white text-xs font-bold uppercase tracking-wider hover:bg-blue-700 transition-colors"
                >
                  <img src={downloadIcon.src} alt="Download" class="w-5 h-5" />
                  Unduh Materi
                </a>
                <a
                  href={pdfSrc}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-center gap-2 w-full py-2.5 rounded-full border border-slate-300 text-slate-700 text-xs font-bold uppercase tracking-wider hover:bg-slate-50 transition-colors"
                >
                  <img src={eyeIcon.src} alt="" class="w-4 h-4" />
                  Buka di Tab Baru
                </a>
              </div>
            </div>
          </div>

          <!-- Share -->
          <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5 flex flex-col gap-3">
            <span class="text-slate-400 font-semibold uppercase text-xs tracking-wider">Bagikan</span>
            <div class="flex items-center gap-2">
              <button class="w-9 h-9 rounded-full bg-slate-100 hover:bg-blue-50 hover:text-blue-600 text-slate-500 flex items-center justify-center transition-colors" title="Bagikan ke X">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </button>
              <button class="w-9 h-9 rounded-full bg-slate-100 hover:bg-blue-50 hover:text-blue-600 text-slate-500 flex items-center justify-center transition-colors" title="Bagikan ke WhatsApp">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.52 3.48A11.86 11.86 0 0012.06 0C5.5 0 .19 5.31.19 11.87c0 2.09.55 4.13 1.6 5.93L0 24l6.35-1.66a11.86 11.86 0 005.7 1.45h.01c6.56 0 11.87-5.31 11.87-11.87 0-3.17-1.24-6.15-3.41-8.44zM12.06 21.6h-.01a9.7 9.7 0 01-4.95-1.36l-.35-.21-3.68.97.98-3.59-.23-.37a9.7 9.7 0 01-1.49-5.17c0-5.36 4.36-9.72 9.73-9.72 2.6 0 5.04 1.01 6.88 2.85a9.66 9.66 0 012.85 6.88c0 5.36-4.37 9.72-9.73 9.72z"/></svg>
              </button>
              <button class="w-9 h-9 rounded-full bg-slate-100 hover:bg-blue-50 hover:text-blue-600 text-slate-500 flex items-center justify-center transition-colors" title="Salin tautan">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 010 5.656l-3 3a4 4 0 01-5.656-5.656l1.5-1.5M10.172 13.828a4 4 0 010-5.656l3-3a4 4 0 015.656 5.656l-1.5 1.5"/></svg>
              </button>
            </div>
          </div>
        </aside>
      </div>

      <!-- Rekomendasi Jurnal Terkait -->
      <div class="flex flex-col gap-6 pt-8 border-t border-slate-100">
        <div class="flex flex-col gap-2">
          <h2 class="text-2xl font-bold">
            <span class="text-slate-800">Rekomendasi </span>
            <span class="text-blue-600">Materi Terkait</span>
          </h2>
          <p class="text-slate-400 text-sm">
            Materi lain yang mungkin relevan dengan topik ini.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {related.map((item) => (
            <a
              href={item.slug ? `/education/materials/${item.slug}` : `/education/materials/${item.id}`}
              class="block bg-white rounded-2xl shadow-md border border-slate-100 overflow-hidden hover:shadow-lg transition-shadow"
            >
              <div class={`h-32 ${item.color}`}></div>
              <div class="p-5 space-y-3">
                <span class="inline-block px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-blue-600 text-xs font-bold uppercase tracking-wider">
                  {item.tag}
                </span>
                <h3 class="text-slate-800 font-bold text-lg">
                  {item.title}
                </h3>
                <p class="text-slate-600 text-xs leading-relaxed line-clamp-2">
                  {item.description}
                </p>
                <div class="flex items-center justify-between pt-3 border-t border-slate-200">
                  <span class="text-slate-600 text-xs flex items-center gap-2">
                    <img src={pageIcon.src} alt="Pages" class="w-4 h-4" />
                    {item.pages} halaman
                  </span>
                  <div class="flex gap-2">
                    <button class="p-1 rounded hover:bg-slate-100 transition-colors" title="View">
                      <img src={eyeIcon.src} alt="View" class="w-5 h-5" />
                    </button>
                    <button class="p-1 rounded hover:bg-slate-100 transition-colors bg-blue-50" title="Download">
                      <img src={downloadIcon.src} alt="Download" class="w-5 h-5" />
                    </button>
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>