---
// Video Edukasi data
import timeIcon from '../../../assets/time.svg';

const allVideos = [
  {
    id: 1,
    title: "Apa itu INAEEWS?",
    description: "Penjelasan komprehensif tentang Indonesian Archipelago Earthquake Early Warning System (INAEEWS) dan bagaimana sistem ini bekerja untuk memberikan peringatan dini.",
    tag: "Teknis",
    duration: "5 mnt",
    source: "BMKG Indonesia",
    category: "SEMUA",
    link: "https://youtu.be/PDB2FM7JAYY?si=WSbvhVe73Z2I__JS"
  },
  {
    id: 2,
    title: "Cara Merespons Peringatan Gempa",
    description: "Panduan praktis tentang tindakan yang harus diambil ketika menerima peringatan dini gempa bumi dari INAEEWS untuk keselamatan maksimal.",
    tag: "Edukasi",
    duration: "7 mnt",
    source: "BMKG Indonesia",
    category: "EDUKASI",
    link: "https://youtu.be/PDB2FM7JAYY?si=WSbvhVe73Z2I__JS"
  },
  {
    id: 3,
    title: "Teknologi Deteksi Gempa Real-Time",
    description: "Penjelasan mendalam tentang teknologi dan sensor yang digunakan untuk mendeteksi gempa dalam hitungan detik dengan akurasi tinggi.",
    tag: "Teknis",
    duration: "8 mnt",
    source: "BMKG Indonesia",
    category: "TEKNIS",
    link: "https://youtu.be/PDB2FM7JAYY?si=WSbvhVe73Z2I__JS"
  },
  {
    id: 4,
    title: "Sejarah Gempa Indonesia",
    description: "Dokumentasi tentang sejarah gempa-gempa besar yang terjadi di Indonesia dan dampaknya terhadap masyarakat serta pembelajaran yang dapat diambil.",
    tag: "Edukasi",
    duration: "6 mnt",
    source: "BMKG Indonesia",
    category: "EDUKASI",
    link: "https://youtu.be/PDB2FM7JAYY?si=WSbvhVe73Z2I__JS"
  },
  {
    id: 5,
    title: "Mitigasi Bencana Gempa",
    description: "Strategi dan program mitigasi bencana gempa yang telah dilakukan oleh pemerintah dan lembaga terkait untuk mengurangi risiko bencana.",
    tag: "Panduan",
    duration: "9 mnt",
    source: "BMKG Indonesia",
    category: "PANDUAN",
    link: "https://youtu.be/PDB2FM7JAYY?si=WSbvhVe73Z2I__JS"
  },
  {
    id: 6,
    title: "Tsunami dan Gempa Bawah Laut",
    description: "Penjelasan tentang hubungan antara gempa bawah laut dan terjadinya tsunami serta sistem peringatan khusus untuk tsunami.",
    tag: "Teknis",
    duration: "10 mnt",
    source: "BMKG Indonesia",
    category: "TEKNIS",
    link: "https://youtu.be/PDB2FM7JAYY?si=WSbvhVe73Z2I__JS"
  },
  {
    id: 7,
    title: "Preparedness Rumah Tangga",
    description: "Tips dan panduan persiapan di tingkat rumah tangga untuk menghadapi bencana gempa dengan rencana evakuasi yang matang.",
    tag: "Panduan",
    duration: "4 mnt",
    source: "BMKG Indonesia",
    category: "PANDUAN",
    link: "https://youtu.be/PDB2FM7JAYY?si=WSbvhVe73Z2I__JS"
  },
  {
    id: 8,
    title: "Penelitian Gempa di Indonesia",
    description: "Overview tentang penelitian dan studi gempa yang dilakukan oleh berbagai institusi untuk memahami pola dan karakteristik gempa Indonesia.",
    tag: "Edukasi",
    duration: "11 mnt",
    source: "BMKG Indonesia",
    category: "EDUKASI",
    link: "https://youtu.be/PDB2FM7JAYY?si=WSbvhVe73Z2I__JS"
  },
  {
    id: 9,
    title: "Standar Keamanan Bangunan",
    description: "Diskusi mengenai standar keamanan bangunan terhadap gempa bumi dan bagaimana menerapkannya dalam konstruksi bangunan modern.",
    tag: "Teknis",
    duration: "12 mnt",
    source: "BMKG Indonesia",
    category: "TEKNIS",
    link: "https://youtu.be/PDB2FM7JAYY?si=WSbvhVe73Z2I__JS"
  }
];

const itemsPerPage = 9;
const categories = ["SEMUA", "TEKNIS", "EDUKASI", "PANDUAN"];
const sortOptions = [
  { value: "terbaru", label: "TERBARU" },
  { value: "terlama", label: "TERLAMA" },
  { value: "az", label: "JUDUL A-Z" },
  { value: "za", label: "JUDUL Z-A" },
];
---

<section class="snap-start w-full bg-white py-24 px-12 md:px-24 overflow-hidden">
  <div class="max-w-7xl mx-auto flex flex-col gap-12">
    <!-- Header -->
    <div class="flex flex-col items-center gap-3">
      <h2 class="text-center text-4xl font-bold">
        <span class="text-slate-800">Video </span>
        <span class="text-blue-600">Edukasi</span>
      </h2>
      <p class="text-center text-slate-400 text-base max-w-2xl">
        Kumpulan video edukasi seputar sistem peringatan dini gempa bumi Indonesia dan mitigasi bencana.
      </p>
    </div>

    <!-- Filter and Sort Section -->
    <div class="relative flex items-center w-full">
      <!-- Sort Dropdown -->
      <div class="relative flex-shrink-0" id="sortDropdownWrapper">
        <button
          type="button"
          id="sortDropdownBtn"
          class="flex items-center gap-2 px-4 py-2 rounded-lg border border-slate-400 text-slate-700 text-sm font-bold uppercase tracking-wider hover:bg-slate-50 transition-colors whitespace-nowrap"
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          <span id="sortDropdownLabel">TERBARU</span>
          <svg id="sortDropdownIcon" class="w-4 h-4 transition-transform" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div
          id="sortDropdownMenu"
          class="hidden absolute left-0 top-full mt-2 w-44 bg-white rounded-lg border border-slate-200 shadow-lg overflow-hidden z-20"
          role="listbox"
        >
          {sortOptions.map((opt) => (
            <button
              type="button"
              class="sort-option w-full text-left px-4 py-2.5 text-sm font-semibold uppercase tracking-wider text-slate-700 hover:bg-blue-50 hover:text-blue-600 transition-colors"
              data-value={opt.value}
            >
              {opt.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Category Tabs — absolute center -->
      <div class="absolute left-1/2 -translate-x-1/2 flex items-center gap-6">
        {categories.map((category) => (
        <button 
            class={`text-sm font-semibold uppercase tracking-wide transition-colors pb-2 border-b-2 whitespace-nowrap ${
            category === "SEMUA"
                ? "text-blue-600 border-b-blue-600"
                : "text-slate-400 border-b-transparent hover:text-slate-600"
            }`}
            data-category={category}
        >
            {category}
        </button>
        ))}
      </div>

      <!-- Search -->
      <div
        id="searchWrapper"
        class="ml-auto h-8 px-4 py-1 rounded-full border border-slate-400 focus-within:border-blue-500 inline-flex items-center gap-2 overflow-hidden hover:border-slate-500 transition-[width] duration-300 ease-in-out flex-shrink-0"
      >
        <input
          type="text"
          id="videoSearchInput"
          placeholder="SEARCH"
          class="flex-1 min-w-0 bg-transparent outline-none text-slate-700 text-xs font-bold uppercase leading-4 tracking-wider placeholder-slate-400"
        />
        <button type="button" id="videoSearchBtn" class="w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 hover:bg-slate-100 transition-colors">
          <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Result count -->
    <p id="videoResultCount" class="text-xs text-slate-400 -mt-8"></p>

    <!-- Videos Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6" id="videosGrid">
      {allVideos.slice(0, itemsPerPage).map((video) => (
        <a href={video.link} target="_blank" rel="noopener noreferrer" class="block bg-white rounded-2xl shadow-md border border-slate-100 overflow-hidden hover:shadow-lg transition-shadow">
          <!-- Video Thumbnail -->
          <div class="relative h-48 bg-gradient-to-br from-blue-100 to-cyan-50 flex items-center justify-center overflow-hidden">
            <div class="relative z-10 flex flex-col items-center gap-3 hover:scale-110 transition-transform">
              <div class="w-16 h-16 bg-blue-600 rounded-full flex items-center justify-center shadow-lg">
                <svg class="w-6 h-6 text-white fill-current" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
              <span class="text-slate-600 text-xs font-bold uppercase tracking-wide">Tonton Video</span>
            </div>
          </div>
          
          <!-- Content -->
          <div class="p-5 space-y-3">
            <span class="inline-block px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-blue-600 text-xs font-bold uppercase tracking-wider">
              {video.tag}
            </span>
            <h3 class="text-slate-800 font-bold text-lg">
              {video.title}
            </h3>
            <p class="text-slate-600 text-xs leading-relaxed line-clamp-2">
              {video.description}
            </p>
            <div class="border-t border-slate-200 pt-3 flex items-center justify-between">
              <span class="text-slate-600 text-xs flex items-center gap-2">
                <img src={timeIcon.src} alt="duration" class="w-4 h-4" />
                {video.duration}
              </span>
              <span class="text-slate-600 text-xs">
                {video.source}
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Empty state -->
    <div id="videoEmptyState" class="hidden flex-col items-center justify-center py-12 text-center">
      <p class="text-slate-500 text-base">Tidak ada video yang cocok dengan pencarian atau kategori Anda.</p>
    </div>

    <!-- Pagination -->
    <div class="flex items-center justify-end gap-2" id="videoPaginationWrapper">
      <button class="p-2 text-slate-600 hover:text-slate-900 transition-colors" id="prevBtn">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>

      <div class="flex items-center gap-1" id="paginationContainer">
        {Array.from({ length: Math.ceil(allVideos.length / itemsPerPage) }).map((_, index) => (
          <button
            class={`w-8 h-8 rounded text-sm font-bold transition-colors ${
              index === 0
                ? "bg-blue-600 text-white"
                : "bg-slate-100 text-slate-700 hover:bg-slate-200"
            }`}
            data-page={index + 1}
          >
            {index + 1}
          </button>
        ))}
      </div>

      <button class="p-2 text-slate-600 hover:text-slate-900 transition-colors" id="nextBtn">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
    </div>
  </div>
</section>

<script define:vars={{ allVideos, itemsPerPage, timeIconSrc: timeIcon.src }}>
  let currentPage = 1;
  let searchQuery = '';
  let sortValue = 'terbaru';
  let activeCategory = 'SEMUA';
  let filteredVideos = [...allVideos];

  const videosGrid = document.getElementById('videosGrid');
  const paginationContainer = document.getElementById('paginationContainer');
  const paginationWrapper = document.getElementById('videoPaginationWrapper');
  const emptyState = document.getElementById('videoEmptyState');
  const resultCount = document.getElementById('videoResultCount');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');

  const searchInput = document.getElementById('videoSearchInput');
  const searchBtn = document.getElementById('videoSearchBtn');
  const searchWrapper = document.getElementById('searchWrapper');

  const sortDropdownWrapper = document.getElementById('sortDropdownWrapper');
  const sortDropdownBtn = document.getElementById('sortDropdownBtn');
  const sortDropdownMenu = document.getElementById('sortDropdownMenu');
  const sortDropdownLabel = document.getElementById('sortDropdownLabel');
  const sortDropdownIcon = document.getElementById('sortDropdownIcon');

  // --- Search box sizing: matches the sort button's width by default,
  // and expands a bit wider when focused/clicked ---
  function syncSearchWidth() {
    const baseWidth = sortDropdownBtn.offsetWidth;
    searchWrapper.dataset.baseWidth = baseWidth;
    if (document.activeElement !== searchInput) {
      searchWrapper.style.width = baseWidth + 'px';
    }
  }
  syncSearchWidth();
  window.addEventListener('resize', syncSearchWidth);

  searchInput.addEventListener('focus', () => {
    const baseWidth = parseInt(searchWrapper.dataset.baseWidth || '128', 10);
    searchWrapper.style.width = (baseWidth + 96) + 'px';
  });

  searchInput.addEventListener('blur', () => {
    if (searchInput.value.trim() === '') {
      const baseWidth = parseInt(searchWrapper.dataset.baseWidth || '128', 10);
      searchWrapper.style.width = baseWidth + 'px';
    }
  });

  // --- Category filter (existing behavior, kept) ---
  document.querySelectorAll('[data-category]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-category]').forEach(b => {
        b.classList.remove('text-blue-600', 'border-b-blue-600');
        b.classList.add('text-slate-400', 'border-b-transparent');
      });
      btn.classList.add('text-blue-600', 'border-b-blue-600');
      btn.classList.remove('text-slate-400', 'border-b-transparent');

      activeCategory = btn.getAttribute('data-category');
      applyFilters();
    });
  });

  function getBaseByCategory() {
    if (activeCategory === 'SEMUA') return allVideos;
    return allVideos.filter(v => v.category === activeCategory);
  }

  function applySort(list) {
    const sorted = [...list];
    switch (sortValue) {
      case 'terbaru':
        sorted.sort((a, b) => b.id - a.id);
        break;
      case 'terlama':
        sorted.sort((a, b) => a.id - b.id);
        break;
      case 'az':
        sorted.sort((a, b) => a.title.localeCompare(b.title));
        break;
      case 'za':
        sorted.sort((a, b) => b.title.localeCompare(a.title));
        break;
    }
    return sorted;
  }

  function applyFilters() {
    const query = searchQuery.trim().toLowerCase();

    let result = getBaseByCategory().filter((video) => {
      if (query === '') return true;
      const haystack = [video.title, video.description, video.tag, video.source].join(' ').toLowerCase();
      return haystack.includes(query);
    });

    result = applySort(result);
    filteredVideos = result;
    currentPage = 1;
    renderVideos();
    renderPagination();
    updateResultCount();
  }

  function updateResultCount() {
    if (!resultCount) return;
    if (searchQuery.trim() === '' && activeCategory === 'SEMUA') {
      resultCount.textContent = `Menampilkan semua ${allVideos.length} video`;
    } else {
      resultCount.textContent = `Ditemukan ${filteredVideos.length} dari ${allVideos.length} video`;
    }
  }

  function renderVideos() {
    if (filteredVideos.length === 0) {
      videosGrid.classList.add('hidden');
      paginationWrapper.classList.add('hidden');
      emptyState.classList.remove('hidden');
      emptyState.classList.add('flex');
      return;
    } else {
      videosGrid.classList.remove('hidden');
      paginationWrapper.classList.remove('hidden');
      emptyState.classList.add('hidden');
      emptyState.classList.remove('flex');
    }

    const start = (currentPage - 1) * itemsPerPage;
    const end = start + itemsPerPage;
    const paginatedVideos = filteredVideos.slice(start, end);

    videosGrid.innerHTML = paginatedVideos.map(video => `
      <a href="${video.link}" target="_blank" rel="noopener noreferrer" class="block bg-white rounded-2xl shadow-md border border-slate-100 overflow-hidden hover:shadow-lg transition-shadow">
        <!-- Video Thumbnail -->
        <div class="relative h-48 bg-gradient-to-br from-blue-100 to-cyan-50 flex items-center justify-center overflow-hidden">
          <div class="relative z-10 flex flex-col items-center gap-3 hover:scale-110 transition-transform">
            <div class="w-16 h-16 bg-blue-600 rounded-full flex items-center justify-center shadow-lg">
              <svg class="w-6 h-6 text-white fill-current" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </div>
            <span class="text-slate-600 text-xs font-bold uppercase tracking-wide">Tonton Video</span>
          </div>
        </div>
        
        <!-- Content -->
        <div class="p-5 space-y-3">
          <span class="inline-block px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-blue-600 text-xs font-bold uppercase tracking-wider">
            ${video.tag}
          </span>
          <h3 class="text-slate-800 font-bold text-lg">
            ${video.title}
          </h3>
          <p class="text-slate-600 text-xs leading-relaxed line-clamp-2">
            ${video.description}
          </p>
          <div class="border-t border-slate-200 pt-3 flex items-center justify-between">
            <span class="text-slate-600 text-xs flex items-center gap-2">
              <img src="${timeIconSrc}" alt="duration" class="w-4 h-4" />
              ${video.duration}
            </span>
            <span class="text-slate-600 text-xs">
              ${video.source}
            </span>
          </div>
        </div>
      </a>
    `).join('');
  }

  function renderPagination() {
    const totalPages = Math.ceil(filteredVideos.length / itemsPerPage);
    paginationContainer.innerHTML = '';

    // Show page numbers with ellipsis
    let startPage = Math.max(1, currentPage - 1);
    let endPage = Math.min(totalPages, currentPage + 1);

    if (currentPage <= 2) {
      endPage = Math.min(totalPages, 3);
    }
    if (currentPage > totalPages - 2) {
      startPage = Math.max(1, totalPages - 2);
    }

    // Previous ellipsis
    if (startPage > 1) {
      const prevEllipsis = document.createElement('span');
      prevEllipsis.textContent = '...';
      prevEllipsis.className = 'text-slate-400';
      paginationContainer.appendChild(prevEllipsis);
    }

    // Page numbers
    for (let i = startPage; i <= endPage; i++) {
      const btn = document.createElement('button');
      btn.className = `w-8 h-8 rounded text-sm font-bold transition-colors ${
        i === currentPage
          ? 'bg-blue-600 text-white'
          : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
      }`;
      btn.textContent = i;
      btn.setAttribute('data-page', i);
      btn.addEventListener('click', () => {
        currentPage = i;
        renderVideos();
        renderPagination();
      });
      paginationContainer.appendChild(btn);
    }

    // Next ellipsis
    if (endPage < totalPages) {
      const nextEllipsis = document.createElement('span');
      nextEllipsis.textContent = '...';
      nextEllipsis.className = 'text-slate-400';
      paginationContainer.appendChild(nextEllipsis);
    }

    // Update prev/next buttons
    prevBtn.disabled = currentPage === 1;
    nextBtn.disabled = currentPage === totalPages;
    prevBtn.style.opacity = currentPage === 1 ? '0.5' : '1';
    nextBtn.style.opacity = currentPage === totalPages ? '0.5' : '1';
  }

  prevBtn.addEventListener('click', () => {
    if (currentPage > 1) {
      currentPage--;
      renderVideos();
      renderPagination();
    }
  });

  nextBtn.addEventListener('click', () => {
    const totalPages = Math.ceil(filteredVideos.length / itemsPerPage);
    if (currentPage < totalPages) {
      currentPage++;
      renderVideos();
      renderPagination();
    }
  });

  // --- Search ---
  let searchDebounce;
  searchInput.addEventListener('input', (e) => {
    clearTimeout(searchDebounce);
    const value = e.target.value;
    searchDebounce = setTimeout(() => {
      searchQuery = value;
      applyFilters();
    }, 200);
  });

  searchInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      clearTimeout(searchDebounce);
      searchQuery = searchInput.value;
      applyFilters();
    }
  });

  searchBtn.addEventListener('click', () => {
    clearTimeout(searchDebounce);
    searchQuery = searchInput.value;
    applyFilters();
    searchInput.focus();
  });

  // --- Sort dropdown ---
  function closeSortDropdown() {
    sortDropdownMenu.classList.add('hidden');
    sortDropdownBtn.setAttribute('aria-expanded', 'false');
    sortDropdownIcon.style.transform = 'rotate(0deg)';
  }

  function openSortDropdown() {
    sortDropdownMenu.classList.remove('hidden');
    sortDropdownBtn.setAttribute('aria-expanded', 'true');
    sortDropdownIcon.style.transform = 'rotate(180deg)';
  }

  sortDropdownBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = !sortDropdownMenu.classList.contains('hidden');
    if (isOpen) {
      closeSortDropdown();
    } else {
      openSortDropdown();
    }
  });

  document.querySelectorAll('.sort-option').forEach((option) => {
    option.addEventListener('click', () => {
      sortValue = option.getAttribute('data-value');
      sortDropdownLabel.textContent = option.textContent.trim();
      closeSortDropdown();
      syncSearchWidth();
      applyFilters();
    });
  });

  document.addEventListener('click', (e) => {
    if (!sortDropdownWrapper.contains(e.target)) {
      closeSortDropdown();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeSortDropdown();
    }
  });

  // Initialize
  filteredVideos = applySort(allVideos);
  renderVideos();
  renderPagination();
  updateResultCount();
</script>