      affected: [{ region: "Kabupaten Lebak, Banten",    intensity: "2", cities: "Rangkasbitung, Cibadak" },
                 { region: "Kabupaten Serang, Banten",   intensity: "1", cities: "Kecamatan Ciomas" }] },
    { id: 25, date: "2026/05/16 18:07", lat: "6.5S",  lon: "106.9E", epicenter: "Kabupaten Bogor, Jawa Barat",             richter: 2.5, depth: "5km",   intensity: "1",  announce: "2026/05/16 18:10",
      affected: [{ region: "Kabupaten Bogor, Jawa Barat", intensity: "1", cities: "Cileungsi, Klapanunggal" }] },
  ];

  function getRichterClass(r) {
    if (r < 3.0) return 'richter-low';
    if (r < 4.5) return 'richter-mid';
    if (r < 5.5) return 'richter-high';
    return 'richter-vhigh';
  }

  function getIntensityClass(i) {
    const map = { '1':'intensity-badge-1','2':'intensity-badge-2','3':'intensity-badge-3','4':'intensity-badge-4','5-':'intensity-badge-5-','5+':'intensity-badge-5+','6-':'intensity-badge-6-','6+':'intensity-badge-6+','7':'intensity-badge-7' };
    return map[i] || 'intensity-badge-1';
  }

  function getParams() {
    const p = new URLSearchParams(window.location.search);
    return parseInt(p.get('id') || '1', 10);
  }

  function render() {
    const id = getParams();
    const ev = eventData.find(e => e.id === id) || eventData[0];

    // Info table
    const infoBody = document.getElementById('detailInfoBody');
    if (infoBody) {
      infoBody.innerHTML = `
        <tr class="border-t border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900">
          <td class="px-6 py-5 font-bold text-slate-900 dark:text-white text-sm">${ev.date}</td>
          <td class="px-6 py-5 text-center text-sm text-slate-700 dark:text-slate-300">${ev.lat}</td>
          <td class="px-6 py-5 text-center text-sm text-slate-700 dark:text-slate-300">${ev.lon}</td>
          <td class="px-6 py-5 text-center">
            <span class="inline-flex items-center justify-center px-3 py-1.5 rounded-lg font-bold text-xs ${getRichterClass(ev.richter)}">${ev.richter}</span>
          </td>
          <td class="px-6 py-5 text-center text-sm text-slate-700 dark:text-slate-300">${ev.depth}</td>
          <td class="px-6 py-5 text-sm text-slate-700 dark:text-slate-300">${ev.epicenter}</td>
        </tr>
      `;
    }

    // Intensity table
    const intensityBody = document.getElementById('detailIntensityBody');
    if (intensityBody) {
      if (!ev.affected || ev.affected.length === 0) {
        intensityBody.innerHTML = `
          <tr>
            <td colspan="3" class="px-6 py-8 text-center text-slate-400 text-sm">Tidak ada wilayah terdampak yang tercatat.</td>
          </tr>`;
      } else {
        intensityBody.innerHTML = ev.affected.map((row, i) => `
          <tr class="border-t border-slate-200 dark:border-slate-700 ${i % 2 === 0 ? 'bg-white dark:bg-slate-900' : 'bg-slate-50 dark:bg-slate-800/50'} hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors">
            <td class="px-6 py-5 font-bold text-slate-900 dark:text-white text-sm">${row.region}</td>
            <td class="px-6 py-5 text-center">
              <span class="inline-flex items-center justify-center w-10 h-10 rounded-full font-black text-sm ${getIntensityClass(row.intensity)}">${row.intensity}</span>
            </td>
            <td class="px-6 py-5 text-sm text-slate-700 dark:text-slate-300">${row.cities}</td>
          </tr>
        `).join('');
      }
    }
  }

  render();
</script>
