---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import homeIcon from '../../assets/home.svg?url';
import navigateIcon from '../../assets/navigate.svg?url';
import gambaranMap from '../../assets/gambaranmap.png';
---
<Layout title="Detail Gempa - Indonesia Earthquake Early Warning System">
  <div class="theme-app h-screen overflow-y-scroll snap-y snap-mandatory bg-slate-50 dark:bg-slate-950 transition-colors duration-500 text-slate-900 dark:text-white">
    <Header />
    <main>
      <!-- Hero Section -->
      <div class="snap-start w-full bg-slate-600 pt-[180px] pb-[180px] px-12 md:px-24 overflow-hidden">
        <div class="max-w-7xl mx-auto">
          <!-- Title -->
          <div class="mb-10">
            <h1 class="text-white text-6xl font-bold leading-tight font-sans">
              DETAIL GEMPA
            </h1>
          </div>

          <!-- Breadcrumb Section -->
          <div class="flex items-center gap-2 mb-10">
            <a href="/about" class="hover:opacity-80 transition-opacity">
              <img src={homeIcon} alt="home" class="w-6 h-6 cursor-pointer" />
            </a>
            <img src={navigateIcon} alt="navigate" class="w-6 h-6" />
            <a href="/product/event" class="text-white text-xl font-semibold hover:opacity-80 transition-opacity cursor-pointer">
              Repository
            </a>
            <img src={navigateIcon} alt="navigate" class="w-6 h-6" />
            <div class="text-white text-xl font-semibold font-sans">
              Detail Gempa
            </div>
          </div>
        </div>
      </div>

      <!-- Content Section -->
      <section class="snap-start w-full bg-white dark:bg-slate-900 py-24 px-12 md:px-24 overflow-hidden">
        <div class="max-w-7xl mx-auto flex flex-col gap-12">

      <!-- Header -->
      <div class="flex flex-col items-center gap-3">
        <h2 class="text-center text-4xl font-bold">
          <span class="text-slate-800 dark:text-white">Detail</span>
          <span class="text-blue-600"> Gempa Bumi</span>
        </h2>
        <p class="text-center text-slate-400 dark:text-slate-400 text-base max-w-2xl">
          Informasi lengkap tentang kejadian gempa bumi, termasuk ringkasan data seismik, peta distribusi intensitas, riwayat EEWS, dan wilayah terdampak.
        </p>
      </div>


      <!-- RINGKASAN GEMPA -->
      <div class="rounded-lg overflow-hidden shadow-lg border border-slate-100 dark:border-slate-600">
        <div class="bg-blue-600 dark:bg-blue-200 px-5 py-3">
          <h2 class="text-white dark:text-slate-900 font-bold text-base">Ringkasan Gempa yang Terjadi (Nilai Sementara)</h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm border-collapse">
            <thead class="bg-blue-600 dark:bg-blue-200 text-white">
              <tr class="text-xs uppercase tracking-wide">
                <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-widest">Tanggal &amp; Waktu</th>
                <th class="px-4 py-3 text-left text-xs font-black uppercase tracking-widest">Episentrum</th>
                <th class="px-4 py-3 text-center text-xs font-black uppercase tracking-widest">Lintang</th>
                <th class="px-4 py-3 text-center text-xs font-black uppercase tracking-widest">Bujur</th>
                <th class="px-4 py-3 text-center text-xs font-black uppercase tracking-widest">Kedalaman</th>
                <th class="px-4 py-3 text-center text-xs font-black uppercase tracking-widest">Magnitudo</th>
                <th class="px-4 py-3 text-center text-xs font-black uppercase tracking-widest">Intensitas Maks.</th>
              </tr>
            </thead>
            <tbody id="ringkasanBody"></tbody>
          </table>
        </div>
      </div>

      <!-- PETA PLACEHOLDER -->
      <div class="rounded-lg overflow-hidden shadow-lg border border-slate-100 dark:border-slate-700">
        <div class="bg-blue-600 dark:bg-blue-200 px-5 py-3">
          <h2 class="text-white dark:text-slate-900 font-bold text-base">Peta Distribusi Estimasi Intensitas &amp; Posisi Episentrum</h2>
        </div>
        <!-- MAP PLACEHOLDER -->
        <div class="w-full h-[420px] bg-slate-100 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 overflow-hidden">
          <img src={gambaranMap.src} alt="Gambaran peta distribusi intensitas" class="w-full h-full object-cover object-center" />
        </div>
        <!-- Legenda -->
        <div class="bg-white dark:bg-slate-900 px-5 py-3 flex flex-wrap items-center gap-3">
          <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide mr-1">Skala Intensitas:</span>
          <div class="flex items-center gap-1"><div class="w-5 h-5 rounded-sm bg-[#be123c]"></div><span class="text-xs font-bold">7</span></div>
          <div class="flex items-center gap-1"><div class="w-5 h-5 rounded-sm bg-red-700"></div><span class="text-xs font-bold">6+</span></div>
          <div class="flex items-center gap-1"><div class="w-5 h-5 rounded-sm bg-red-400"></div><span class="text-xs font-bold">6−</span></div>
          <div class="flex items-center gap-1"><div class="w-5 h-5 rounded-sm bg-orange-400"></div><span class="text-xs font-bold">5+</span></div>
          <div class="flex items-center gap-1"><div class="w-5 h-5 rounded-sm bg-yellow-300"></div><span class="text-xs font-bold">5−</span></div>
          <div class="flex items-center gap-1"><div class="w-5 h-5 rounded-sm bg-green-300"></div><span class="text-xs font-bold">4</span></div>
          <div class="flex items-center gap-1"><div class="w-5 h-5 rounded-sm bg-cyan-400"></div><span class="text-xs font-bold">3</span></div>
          <div class="flex items-center gap-1"><div class="w-5 h-5 rounded-sm bg-sky-200"></div><span class="text-xs font-bold">2</span></div>
          <div class="flex items-center gap-1"><div class="w-5 h-5 rounded-sm bg-slate-100 border border-slate-300"></div><span class="text-xs font-bold">1</span></div>
          <span class="ml-auto text-xs text-slate-400">★ : Episentrum (nilai sementara)</span>
        </div>
      </div>

      <!-- PETA PLACEHOLDER -->
      <div class="rounded-lg overflow-hidden shadow-lg border border-slate-100 dark:border-slate-600">
        <div class="bg-blue-600 dark:bg-blue-200 px-5 py-3">
          <h2 class="text-white dark:text-slate-900 font-bold text-base">Peta Distribusi Estimasi Intensitas &amp; Posisi Episentrum</h2>
        </div>
        <!-- MAP PLACEHOLDER -->
        <div class="w-full h-[420px] bg-slate-100 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 overflow-hidden">
          <img src={gambaranMap.src} alt="Gambaran peta distribusi intensitas" class="w-full h-full object-cover object-center" />
        </div>
      </div>

      <!-- RIWAYAT EEWS -->
      <div class="rounded-lg overflow-hidden shadow-lg border border-slate-100 dark:border-slate-600">
        <div class="bg-blue-600 dark:bg-blue-200 px-5 py-3 flex flex-wrap items-center justify-between gap-2">
          <h2 class="text-white dark:text-slate-900 font-bold text-base">Riwayat Laporan Peringatan Dini Gempa (EEWS)</h2>
          <span class="text-blue-200 dark:text-slate-700 text-xs">(Laporan ke-2 = tingkat PERINGATAN, ditandai latar abu-abu)</span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-xs border-collapse">
            <thead>
              <tr class="bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-100 uppercase tracking-wide">
                <th class="px-3 py-3 text-center font-semibold border border-slate-300 dark:border-slate-600" rowspan="2">Lap.</th>
                <th class="px-3 py-3 text-center font-semibold border border-slate-300 dark:border-slate-600" rowspan="2">Waktu Laporan</th>
                <th class="px-3 py-3 text-center font-semibold border border-slate-300 dark:border-slate-600" rowspan="2">Waktu sejak<br/>Deteksi (dtk)</th>
                <th class="px-3 py-3 text-center font-semibold border border-slate-300 dark:border-slate-600" colspan="4">Elemen Episentrum</th>
                <th class="px-3 py-3 text-center font-semibold border border-slate-300 dark:border-slate-600" rowspan="2">Prediksi Intensitas Maks.</th>
              </tr>
              <tr class="bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-100 uppercase tracking-wide">
                <th class="px-3 py-2 text-center font-semibold border border-slate-300">Lintang</th>
                <th class="px-3 py-2 text-center font-semibold border border-slate-300">Bujur</th>
                <th class="px-3 py-2 text-center font-semibold border border-slate-300">Kedalaman</th>
                <th class="px-3 py-2 text-center font-semibold border border-slate-300">Magnitudo</th>
              </tr>
            </thead>
            <tbody id="eewBody"></tbody>
          </table>
        </div>
      </div>

      <!-- WILAYAH TERDAMPAK -->
      <div class="rounded-lg overflow-hidden shadow-lg border border-slate-100 dark:border-slate-600">
        <div class="bg-[#2563eb] px-5 py-3">
          <h2 class="text-white font-bold text-base">Wilayah Terdampak</h2>
          <p class="text-blue-200 text-xs mt-0.5">Kota / kecamatan dengan intensitas guncangan 1 atau lebih</p>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-100 uppercase tracking-wide">
                <th class="px-3 py-2 text-center font-semibold border-y border-slate-300 dark:border-slate-600">Provinsi / Wilayah</th>
                <th class="px-3 py-2 text-center font-semibold border-y border-slate-300 dark:border-slate-600">Intensitas</th>
                <th class="px-3 py-2 text-left font-semibold border-y border-slate-300 dark:border-slate-600">Kota / Kecamatan</th>
              </tr>
            </thead>
            <tbody id="detailIntensityBody"></tbody>
          </table>
        </div>
      </div>
      </section>
    </main>
    <div class="snap-start flex flex-col justify-end">
      <Footer />
    </div>
  </div>
</Layout>

<style>
  /* TABLE BORDERS */
  table { border-collapse: collapse; }

  /* LIGHT rows */
  .row-even { background: #ffffff; color: #0f172a; }
  .row-odd  { background: #f8fafc; color: #0f172a; }
  .dark .row-even { background: #0d1526; color: #e2e8f0; }
  .dark .row-odd  { background: #0a1120; color: #e2e8f0; }

  tbody td { border: 1px solid #e5e7eb; }
  .dark tbody td { border-color: rgba(71,85,105,0.35); }

  /* WARN ROW */
  .eew-warn td { background: #e5e7eb !important; color: #374151; }
  .dark .eew-warn td { background: #1f2937 !important; color: #d1d5db; }

  /* RICHTER badges (align with event.astro) */
  .richter-low   { background-color: #d1fae5; color: #065f46; }
  .richter-mid   { background-color: #fef3c7; color: #92400e; }
  .richter-high  { background-color: #fee2e2; color: #991b1b; }
  .richter-vhigh { background-color: #991b1b; color: #fee2e2; }

  /* INTENSITY badges */
  .i-1  { background:#f1f5f9; color:#475569; border:1px solid #cbd5e1; }
  .i-2  { background:#e0f2fe; color:#075985; }
  .i-3  { background:#bfdbfe; color:#1e3a5f; }
  .i-4  { background:#bbf7d0; color:#14532d; }
  .i-5m { background:#fef08a; color:#713f12; }
  .i-5p { background:#fdba74; color:#7c2d12; }
  .i-6m { background:#fca5a5; color:#7f1d1d; }
  .i-6p { background:#ef4444; color:#fff; }
  .i-7  { background:#be123c; color:#fff; }
</style>

<script>
  const eventData = [
    {
      id: 1,
      date: "2026/05/21 08:11",
      lat: "6°12.4′ LS", lon: "105°48.2′ BT",
      epicenter: "Lepas Pantai Selatan Banten",
      richter: 3.7, depth: "15 km", intensity: "3",
      affected: [
        { region:"Kabupaten Pandeglang, Banten", intensity:"3", cities:"Kec. Carita, Kec. Labuan" },
        { region:"Kabupaten Lebak, Banten",      intensity:"2", cities:"Kec. Malingping" },
      ],
      eew: [
        { rep:1,  time:"08:11:38.8", elapsed:6.3,  lat:"6.0°LS", lon:"105.8°BT", depth:"10km", mag:2.1, intensity:"Maks. Intensitas 1", warn:false },
        { rep:2,  time:"08:11:39.3", elapsed:6.8,  lat:"6.1°LS", lon:"105.8°BT", depth:"10km", mag:2.8, intensity:"Maks. Intensitas 2", warn:false },
        { rep:3,  time:"08:11:41.0", elapsed:8.5,  lat:"6.1°LS", lon:"105.8°BT", depth:"12km", mag:3.5, intensity:"Maks. Intensitas 3", warn:false },
        { rep:4,  time:"08:11:43.2", elapsed:10.7, lat:"6.2°LS", lon:"105.8°BT", depth:"15km", mag:3.7, intensity:"Maks. Intensitas 3", warn:false },
      ]
    },
    {
      id: 6,
      date: "2026/05/20 09:46",
      lat: "5°42.0′ LS", lon: "106°54.0′ BT",
      epicenter: "Laut Jawa Utara Jakarta",
      richter: 5.9, depth: "30 km", intensity: "5+",
      affected: [
        { region:"Jakarta Utara, DKI Jakarta",  intensity:"5+", cities:"Penjaringan, Pademangan, Tanjung Priok" },
        { region:"Jakarta Barat, DKI Jakarta",  intensity:"4",  cities:"Tambora, Grogol Petamburan" },
        { region:"Kota Tangerang, Banten",       intensity:"3",  cities:"Neglasari, Batuceper" },
      ],
      eew: [
        { rep:1,  time:"09:46:08.8", elapsed:5.3,  lat:"5.7°LS", lon:"106.9°BT", depth:"10km", mag:4.7, intensity:"Maks. Intensitas 2",  warn:false },
        { rep:2,  time:"09:46:09.3", elapsed:5.8,  lat:"5.7°LS", lon:"106.9°BT", depth:"10km", mag:5.4, intensity:"Maks. Intensitas 3",  warn:false },
        { rep:3,  time:"09:46:09.5", elapsed:6.0,  lat:"5.7°LS", lon:"106.9°BT", depth:"10km", mag:5.5, intensity:"Maks. Intensitas 3",  warn:false },
        { rep:4,  time:"09:46:12.5", elapsed:9.0,  lat:"5.7°LS", lon:"106.9°BT", depth:"20km", mag:6.0, intensity:"Maks. Intensitas 3",  warn:false },
        { rep:5,  time:"09:46:13.6", elapsed:10.1, lat:"5.7°LS", lon:"106.9°BT", depth:"20km", mag:6.0, intensity:"Maks. Intensitas 3",  warn:false },
        { rep:6,  time:"09:46:14.5", elapsed:11.0, lat:"5.7°LS", lon:"106.9°BT", depth:"20km", mag:6.2, intensity:"Maks. Intensitas 5−", warn:false },
        { rep:7,  time:"09:46:17.4", elapsed:13.9, lat:"5.7°LS", lon:"106.9°BT", depth:"20km", mag:6.3, intensity:"Maks. Intensitas 5−", warn:false },
        { rep:8,  time:"09:46:17.5", elapsed:14.0, lat:"5.7°LS", lon:"106.9°BT", depth:"20km", mag:6.5, intensity:"Maks. Intensitas 5+", warn:false },
        { rep:9,  time:"09:46:18.5", elapsed:15.0, lat:"5.7°LS", lon:"106.9°BT", depth:"20km", mag:6.3, intensity:"Maks. Intensitas 5+", warn:false },
        { rep:10, time:"09:46:19.5", elapsed:16.0, lat:"5.7°LS", lon:"106.9°BT", depth:"20km", mag:6.5, intensity:"Maks. Intensitas 5+", warn:false },
        { rep:11, time:"09:46:20.4", elapsed:16.9, lat:"5.7°LS", lon:"106.9°BT", depth:"20km", mag:6.9, intensity:"Maks. Intensitas 5+", warn:false },
        { rep:12, time:"09:46:21.7", elapsed:18.2, lat:"5.7°LS", lon:"106.9°BT", depth:"20km", mag:7.0, intensity:"Maks. Intensitas 5+", warn:false },
        { rep:13, time:"09:46:23.3", elapsed:19.8, lat:"5.7°LS", lon:"106.9°BT", depth:"20km", mag:7.1, intensity:"Maks. Intensitas 5+", warn:true  },
        { rep:14, time:"09:46:23.4", elapsed:19.9, lat:"5.7°LS", lon:"106.9°BT", depth:"30km", mag:7.2, intensity:"Maks. Intensitas 5+", warn:true  },
        { rep:15, time:"09:46:24.5", elapsed:21.0, lat:"5.7°LS", lon:"106.9°BT", depth:"30km", mag:7.3, intensity:"Maks. Intensitas 5+", warn:true  },
        { rep:16, time:"09:46:25.2", elapsed:21.7, lat:"5.7°LS", lon:"106.9°BT", depth:"30km", mag:7.2, intensity:"Maks. Intensitas 5+", warn:true  },
        { rep:17, time:"09:46:25.8", elapsed:22.3, lat:"5.7°LS", lon:"106.9°BT", depth:"30km", mag:6.9, intensity:"Maks. Intensitas 5+", warn:true  },
        { rep:18, time:"09:46:26.3", elapsed:22.8, lat:"5.7°LS", lon:"106.9°BT", depth:"30km", mag:7.0, intensity:"Maks. Intensitas 5+", warn:true  },
        { rep:19, time:"09:46:29.3", elapsed:25.8, lat:"5.7°LS", lon:"106.9°BT", depth:"30km", mag:6.7, intensity:"Maks. Intensitas 5+", warn:true  },
        { rep:20, time:"09:46:29.5", elapsed:26.0, lat:"5.7°LS", lon:"106.9°BT", depth:"30km", mag:6.8, intensity:"Maks. Intensitas 5+", warn:true  },
      ]
    }
  ];

  function rClass(r) {
    if (r < 3.0) return 'richter-low';
    if (r < 4.5) return 'richter-mid';
    if (r < 5.5) return 'richter-high';
    return 'richter-vhigh';
  }
  function iClass(i) {
    const m = {'1':'i-1','2':'i-2','3':'i-3','4':'i-4','5-':'i-5m','5+':'i-5p','6-':'i-6m','6+':'i-6p','7':'i-7'};
    return m[i] || 'i-1';
  }

  function render() {
    const id = parseInt(new URLSearchParams(window.location.search).get('id') || '6', 10);
    const ev = eventData.find(e => e.id === id) || eventData[0];

    // Ringkasan
    document.getElementById('ringkasanBody').innerHTML = `
      <tr class="row-even">
        <td class="px-4 py-3 font-semibold text-sm">${ev.date}</td>
        <td class="px-4 py-3 text-center text-sm">${ev.epicenter}</td>
        <td class="px-4 py-3 text-center text-sm">${ev.lat}</td>
        <td class="px-4 py-3 text-center text-sm">${ev.lon}</td>
        <td class="px-4 py-3 text-center text-sm">${ev.depth}</td>
        <td class="px-4 py-3 text-center">
          <span class="inline-flex items-center justify-center px-3 py-1 rounded text-xs font-bold ${rClass(ev.richter)}">
            ${ev.richter}
          </span>
        </td>
        <td class="px-4 py-3 text-center">
          <span class="inline-flex items-center justify-center w-10 h-10 rounded text-sm font-black ${iClass(ev.intensity)}">
            ${ev.intensity}
          </span>
        </td>
      </tr>`;

    // EEW
    document.getElementById('eewBody').innerHTML = (ev.eew || []).map((r, i) => {
      const rc = r.warn ? 'eew-warn' : i % 2 === 0 ? 'row-even' : 'row-odd';
      return `<tr class="${rc}">
        <td class="px-3 py-2 text-center font-bold border border-slate-100">${r.rep}</td>
        <td class="px-3 py-2 text-center border border-slate-100">${r.time}</td>
        <td class="px-3 py-2 text-center border border-slate-100">${r.elapsed}</td>
        <td class="px-3 py-2 text-center border border-slate-100">${r.lat}</td>
        <td class="px-3 py-2 text-center border border-slate-100">${r.lon}</td>
        <td class="px-3 py-2 text-center border border-slate-100">${r.depth}</td>
        <td class="px-3 py-2 text-center font-semibold border border-slate-100">${r.mag}</td>
        <td class="px-3 py-2 text-center border border-slate-100">${r.intensity}</td>
      </tr>`;
    }).join('');

    // Wilayah terdampak
    document.getElementById('detailIntensityBody').innerHTML = ev.affected.map((row, i) => `
      <tr class="${i % 2 === 0 ? 'row-even' : 'row-odd'}">
        <td class="px-5 py-4 font-semibold text-sm border-y border-slate-200 dark:border-slate-600">${row.region}</td>
        <td class="px-5 py-4 text-center border-y border-slate-200 dark:border-slate-600">
          <span class="inline-flex items-center justify-center w-8 h-8 rounded text-sm font-black ${iClass(row.intensity)}">
            ${row.intensity}
          </span>
        </td>
        <td class="px-5 py-4 text-sm border-y border-slate-200 dark:border-slate-600">${row.cities}</td>
      </tr>`).join('');
  }

  render();
</script>