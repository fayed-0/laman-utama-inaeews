    @import url('https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;600;700&display=swap');
  }
  .font-sans { font-family: 'Work Sans', sans-serif; }
  .richter-low   { background-color: #d1fae5; color: #065f46; }
  .richter-mid   { background-color: #fef3c7; color: #92400e; }
  .richter-high  { background-color: #fee2e2; color: #991b1b; }
  .richter-vhigh { background-color: #991b1b; color: #fee2e2; }

  .intensity-badge-1  { background-color: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; }
  .intensity-badge-2  { background-color: #e0f2fe; color: #0369a1; }
  .intensity-badge-3  { background-color: #dbeafe; color: #1d4ed8; }
  .intensity-badge-4  { background-color: #fef9c3; color: #92400e; }
  .intensity-badge-5- { background-color: #fde68a; color: #92400e; }
  .intensity-badge-5+ { background-color: #fdba74; color: #7c2d12; }
  .intensity-badge-6- { background-color: #fca5a5; color: #7f1d1d; }
  .intensity-badge-6+ { background-color: #ef4444; color: #fff; }
  .intensity-badge-7  { background-color: #be123c; color: #fff; }
</style>

