---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import homeIcon from '../../assets/home.svg?url';
import navigateIcon from '../../assets/navigate.svg?url';
---
<Layout title="Detail Gempa - Indonesia Earthquake Early Warning System">
  <div class="theme-app h-screen overflow-y-scroll snap-y snap-mandatory bg-slate-50 dark:bg-slate-950 transition-colors duration-500 text-slate-900 dark:text-white">
    <Header />
    <main>

      <!-- Hero Section -->
      <div class="snap-start w-full bg-slate-600 pt-32 pb-32 px-12 md:px-24 overflow-hidden">
        <div class="max-w-7xl mx-auto">
          <div class="mb-10">
            <h1 class="text-white text-6xl font-bold leading-tight font-sans">
              Detail Gempa
            </h1>
          </div>
          <div class="flex items-center gap-2">
            <a href="/" class="hover:opacity-80 transition-opacity">
              <img src={homeIcon} alt="home" class="w-6 h-6 cursor-pointer" />
            </a>
            <img src={navigateIcon} alt="navigate" class="w-6 h-6" />
            <a href="/components/product/Repository" class="text-slate-300 hover:text-white text-xl font-semibold font-sans transition-colors">
              Repository
            </a>
            <img src={navigateIcon} alt="navigate" class="w-6 h-6" />
            <div class="text-white text-xl font-semibold font-sans">
              Detail
            </div>
          </div>
        </div>
      </div>

      <!-- Content Section -->
      <section class="snap-start w-full bg-white dark:bg-slate-900 py-24 px-12 md:px-24 overflow-hidden">
        <div class="max-w-7xl mx-auto flex flex-col gap-10">

          <!-- Page Header -->
          <div class="flex flex-col items-center gap-3">
            <h2 class="text-center text-4xl font-bold">
              <span class="text-slate-800 dark:text-white">Detail</span>
              <span class="text-blue-600"> Kejadian Gempa</span>
            </h2>
            <p class="text-center text-slate-400 text-base max-w-2xl">
              Informasi lengkap mengenai lokasi episentrum, skala richter, kedalaman, dan dampak intensitas gempa di wilayah terdampak.
            </p>
          </div>

          <!-- Map Placeholder -->
          <div class="rounded-xl overflow-hidden shadow-lg border border-slate-200 dark:border-slate-700">
            <div id="mapPlaceholder" class="relative w-full bg-blue-50 dark:bg-slate-800" style="height: 420px;">
                <div id="leafletMap" class="w-full h-full"></div>
              </div>

            <!-- Legend -->
            <div class="bg-white dark:bg-slate-800 border-t border-slate-200 dark:border-slate-700 px-6 py-4">
              <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
                <span class="text-xs font-semibold text-slate-600 dark:text-slate-300 mr-2">Skala intensitas gempa bumi</span>
                <div class="flex items-center gap-1.5">
                  <div class="w-6 h-6 rounded-full bg-pink-600 shadow"></div>
                  <span class="text-xs text-slate-600 dark:text-slate-300 font-bold">7</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <div class="w-6 h-6 rounded-full bg-red-800 shadow"></div>
                  <span class="text-xs text-slate-600 dark:text-slate-300 font-bold">6+</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <div class="w-6 h-6 rounded-full bg-red-500 shadow"></div>
                  <span class="text-xs text-slate-600 dark:text-slate-300 font-bold">6-</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <div class="w-6 h-6 rounded-full bg-orange-500 shadow"></div>
                  <span class="text-xs text-slate-600 dark:text-slate-300 font-bold">5+</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <div class="w-6 h-6 rounded-full bg-yellow-400 shadow"></div>
                  <span class="text-xs text-slate-600 dark:text-slate-300 font-bold">5-</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <div class="w-6 h-6 rounded-full bg-amber-200 shadow"></div>
                  <span class="text-xs text-slate-600 dark:text-slate-300 font-bold">4</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <div class="w-6 h-6 rounded-full bg-blue-600 shadow"></div>
                  <span class="text-xs text-slate-600 dark:text-slate-300 font-bold">3</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <div class="w-6 h-6 rounded-full bg-cyan-400 shadow"></div>
                  <span class="text-xs text-slate-600 dark:text-slate-300 font-bold">2</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <div class="w-6 h-6 rounded-full bg-slate-100 border border-slate-300 shadow"></div>
                  <span class="text-xs text-slate-600 dark:text-slate-300 font-bold">1</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <svg viewBox="0 0 24 24" class="w-6 h-6" xmlns="http://www.w3.org/2000/svg">
                    <line x1="4" y1="4" x2="20" y2="20" stroke="#ef4444" stroke-width="3" stroke-linecap="round"/>
                    <line x1="20" y1="4" x2="4" y2="20" stroke="#ef4444" stroke-width="3" stroke-linecap="round"/>
                  </svg>
                  <span class="text-xs text-slate-600 dark:text-slate-300 font-bold">episentrum</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Earthquake Info Table -->
          <div class="overflow-x-auto rounded-lg shadow-lg border border-slate-200 dark:border-slate-600">
            <table class="w-full">
              <thead class="bg-blue-600 dark:bg-blue-200 text-white">
                <tr>
                  <th class="px-6 py-4 text-left text-xs font-black uppercase tracking-widest">Tanggal Deteksi Gempa</th>
                  <th class="px-6 py-4 text-center text-xs font-black uppercase tracking-widest">Lintang</th>
                  <th class="px-6 py-4 text-center text-xs font-black uppercase tracking-widest">Bujur</th>
                  <th class="px-6 py-4 text-center text-xs font-black uppercase tracking-widest">Skala Richter</th>
                  <th class="px-6 py-4 text-center text-xs font-black uppercase tracking-widest">Kedalaman Pusat Gempa</th>
                  <th class="px-6 py-4 text-left text-xs font-black uppercase tracking-widest">Nama Episentrum</th>
                </tr>
              </thead>
              <tbody id="detailInfoBody">
                <!-- Filled by JS -->
              </tbody>
            </table>
          </div>

          <!-- Intensity Section -->
          <div>
            <h3 class="text-xl font-bold text-slate-800 dark:text-white mb-4">
              Kota/desa dengan intensitas gempa 1 atau lebih
            </h3>
            <div class="overflow-x-auto rounded-lg shadow-lg border border-slate-200 dark:border-slate-600">
                <table class="w-full">
                  <thead class="bg-blue-600 dark:bg-blue-200 text-white">
                    <tr>
                      <th class="px-6 py-4 text-left text-xs font-black uppercase tracking-widest">Prefektur / Provinsi</th>
                      <th class="px-6 py-4 text-center text-xs font-black uppercase tracking-widest">Skala Intensitas Gempa Bumi</th>
                      <th class="px-6 py-4 text-left text-xs font-black uppercase tracking-widest">Nama Kota dan Desa</th>
                    </tr>
                  </thead>
                  <tbody id="detailIntensityBody">
                    <!-- Filled by JS -->
                  </tbody>
                </table>
              </div>
          </div>

        </div>
      </section>
    </main>
    <div class="snap-start flex flex-col justify-end">
      <Footer />
    </div>
  </div>
</Layout>

<style>
  :global {
    @import url('https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;600;700&display=swap');
  }
  .font-sans { font-family: 'Work Sans', sans-serif; }
  .richter-low   { background-color: #d1fae5; color: #065f46; }
  .richter-mid   { background-color: #fef3c7; color: #92400e; }
  .richter-high  { background-color: #fee2e2; color: #991b1b; }
  .richter-vhigh { background-color: #991b1b; color: #fee2e2; }

  .intensity-badge-1  { background-color: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; }
  .intensity-badge-2  { background-color: #e0f2fe; color: #0369a1; }
  .intensity-badge-3  { background-color: #dbeafe; color: #1d4ed8; }
  .intensity-badge-4  { background-color: #fef9c3; color: #92400e; }
  .intensity-badge-5- { background-color: #fde68a; color: #92400e; }
  .intensity-badge-5+ { background-color: #fdba74; color: #7c2d12; }
  .intensity-badge-6- { background-color: #fca5a5; color: #7f1d1d; }
  .intensity-badge-6+ { background-color: #ef4444; color: #fff; }
  .intensity-badge-7  { background-color: #be123c; color: #fff; }
</style>

