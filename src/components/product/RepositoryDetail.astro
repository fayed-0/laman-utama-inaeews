  function getRichterClass(r) {
    if (r < 3.0) return 'richter-low';
    if (r < 4.5) return 'richter-mid';
    if (r < 5.5) return 'richter-high';
    return 'richter-vhigh';
  }

  function getIntensityClass(i) {
    const map = { '1':'intensity-badge-1','2':'intensity-badge-2','3':'intensity-badge-3','4':'intensity-badge-4','5-':'intensity-badge-5-','5+':'intensity-badge-5+','6-':'intensity-badge-6-','6+':'intensity-badge-6+','7':'intensity-badge-7' };
    return map[i] || 'intensity-badge-1';
  }

  function getParams() {
    const p = new URLSearchParams(window.location.search);
    return parseInt(p.get('id') || '1', 10);
  }

  function render() {
    const id = getParams();
    const ev = eventData.find(e => e.id === id) || eventData[0];

    // Info table
    const infoBody = document.getElementById('detailInfoBody');
    if (infoBody) {
      infoBody.innerHTML = `
        <tr class="border-t border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900">
          <td class="px-6 py-5 font-bold text-slate-900 dark:text-white text-sm">${ev.date}</td>
          <td class="px-6 py-5 text-center text-sm text-slate-700 dark:text-slate-300">${ev.lat}</td>
          <td class="px-6 py-5 text-center text-sm text-slate-700 dark:text-slate-300">${ev.lon}</td>
          <td class="px-6 py-5 text-center">
            <span class="inline-flex items-center justify-center px-3 py-1.5 rounded-lg font-bold text-xs ${getRichterClass(ev.richter)}">${ev.richter}</span>
          </td>
          <td class="px-6 py-5 text-center text-sm text-slate-700 dark:text-slate-300">${ev.depth}</td>
          <td class="px-6 py-5 text-sm text-slate-700 dark:text-slate-300">${ev.epicenter}</td>
        </tr>
      `;
    }

    // Intensity table
    const intensityBody = document.getElementById('detailIntensityBody');
    if (intensityBody) {
      if (!ev.affected || ev.affected.length === 0) {
        intensityBody.innerHTML = `
          <tr>
            <td colspan="3" class="px-6 py-8 text-center text-slate-400 text-sm">Tidak ada wilayah terdampak yang tercatat.</td>
          </tr>`;
      } else {
        intensityBody.innerHTML = ev.affected.map((row, i) => `
          <tr class="border-t border-slate-200 dark:border-slate-700 ${i % 2 === 0 ? 'bg-white dark:bg-slate-900' : 'bg-slate-50 dark:bg-slate-800/50'} hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors">
            <td class="px-6 py-5 font-bold text-slate-900 dark:text-white text-sm">${row.region}</td>
            <td class="px-6 py-5 text-center">
              <span class="inline-flex items-center justify-center w-10 h-10 rounded-full font-black text-sm ${getIntensityClass(row.intensity)}">${row.intensity}</span>
            </td>
            <td class="px-6 py-5 text-sm text-slate-700 dark:text-slate-300">${row.cities}</td>
          </tr>
        `).join('');
      }
    }
  }

  render();

  // Leaflet + MarkerCluster + MiniMap initialization: load CSS/JS dynamically and render clustered map + minimap
  (function loadLeafletAndPlugins() {
    if (typeof window === 'undefined') return;

    function addCssHref(href, attrName) {
      if (document.querySelector(`link[data-${attrName}]`)) return;
      const l = document.createElement('link');
      l.rel = 'stylesheet';
      l.href = href;
      l.setAttribute(`data-${attrName}`, '');
      document.head.appendChild(l);
    }

    function loadScript(src, cb) {
      const s = document.createElement('script');
      s.src = src;
      s.onload = cb;
      s.onerror = cb;
      document.body.appendChild(s);
    }

    addCssHref('https://unpkg.com/leaflet@1.9.4/dist/leaflet.css', 'leaflet');
    addCssHref('https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css', 'mc');
    addCssHref('https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css', 'mc-default');

    function parseCoord(s) {
      if (!s) return 0;
      s = String(s).trim();
      const dir = s.slice(-1).toUpperCase();
      const num = parseFloat(s.slice(0, -1));
      if (isNaN(num)) return 0;
      if (dir === 'S' || dir === 'W') return -Math.abs(num);
      return Math.abs(num);
    }

    // Load Leaflet, then plugins, then init
    loadScript('https://unpkg.com/leaflet@1.9.4/dist/leaflet.js', function () {
      loadScript('https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js', function () {
        loadScript('https://unpkg.com/leaflet-minimap@3.6.1/dist/Control.MiniMap.min.js', function () {
          try {
            const id = parseInt(new URLSearchParams(window.location.search).get('id') || '1', 10) || 1;
            const ev = eventData.find(e => e.id === id) || eventData[0];
            const lat = parseCoord(ev.lat);
            const lon = parseCoord(ev.lon);

            const mapEl = document.getElementById('leafletMap');
            if (!mapEl) return;
            mapEl.innerHTML = '';

            const map = L.map(mapEl, { scrollWheelZoom: true }).setView([lat || 0, lon || 0], lat && lon ? 6 : 2);

            const mainLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
              attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            // Create marker cluster group and add markers for all events
            const markers = L.markerClusterGroup();
            const markerList = [];
            eventData.forEach(e => {
              const rlat = parseCoord(e.lat);
              const rlon = parseCoord(e.lon);
              if (rlat === 0 && rlon === 0) return;
              const cm = L.circleMarker([rlat, rlon], { radius: 8, color: '#ef4444', fillColor: '#ef4444', fillOpacity: 0.9 });
              cm.bindPopup(`<div class="font-bold">${e.epicenter}</div><div class="text-sm">${e.date}</div><div class="text-sm">Richter: ${e.richter}</div>`);
              markers.addLayer(cm);
              markerList.push({ id: e.id, marker: cm, lat: rlat, lon: rlon });
            });
            map.addLayer(markers);

            // Fit bounds to all markers if available
            try {
              const bounds = markers.getBounds();
              if (bounds.isValid()) map.fitBounds(bounds.pad(0.2));
            } catch (e) { /* ignore */ }

            // If a specific event is selected, open its popup and center on it
            const selected = markerList.find(m => m.id === id);
            if (selected) {
              map.setView([selected.lat, selected.lon], 8);
              selected.marker.openPopup();
            }

            // Add minimap control (small overview map)
            try {
              const miniLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png');
              // eslint-disable-next-line no-undef
              const miniMap = new L.Control.MiniMap(miniLayer, { toggleDisplay: true, minimized: false, position: 'bottomright' }).addTo(map);
            } catch (e) {
              // plugin not available or failed
              console.warn('MiniMap plugin not available', e);
            }
          } catch (err) {
            console.error(err);
          }
        });
      });
    });
  })();
</script>