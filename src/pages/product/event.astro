---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import homeIcon from '../../assets/home.svg?url';
import navigateIcon from '../../assets/navigate.svg?url';
---

<Layout title="Repository - Indonesia Earthquake Early Warning System">
	<div class="theme-app h-screen overflow-y-scroll snap-y snap-mandatory bg-slate-50 dark:bg-slate-950 transition-colors duration-500 text-slate-900 dark:text-white">
		<Header />
		<main>
			<!-- Hero Section -->
			<div class="snap-start w-full bg-slate-600 pt-[180px] pb-[180px] px-12 md:px-24 overflow-hidden">
				<div class="max-w-7xl mx-auto">
					<!-- Title -->
					<div class="mb-10">
						<h1 class="text-white text-6xl font-bold leading-tight font-sans">
							REPOSITORY
						</h1>
					</div>

					<!-- Breadcrumb Section -->
					<div class="flex items-center gap-2 mb-10">
						<a href="/about" class="hover:opacity-80 transition-opacity">
							<img src={homeIcon} alt="home" class="w-6 h-6 cursor-pointer" />
						</a>
						<img src={navigateIcon} alt="navigate" class="w-6 h-6" />
						<div class="text-white text-xl font-semibold font-sans">
							Repository
						</div>
					</div>

					<!-- Steps Section -->
					<div class="flex flex-col md:flex-row items-start md:items-center gap-5 flex-wrap">
						<!-- Step 1 -->
						<div class="flex items-start gap-3.5">
							<div class="flex-shrink-0 w-8 h-8 px-2 py-1.5 bg-white rounded-full flex items-center justify-center">
								<span class="text-slate-600 text-sm font-sans font-medium">1</span>
							</div>
							<div class="w-80 text-white text-base font-sans font-normal leading-6">
								Akses data seismik lengkap dari berbagai gempa bumi.
							</div>
						</div>

						<!-- Connector -->
						<div class="hidden md:flex items-center justify-center w-4 h-14 flex-shrink-0">
							<div class="w-px h-full bg-white"></div>
						</div>

						<!-- Step 2 -->
						<div class="flex items-start gap-3.5">
							<div class="flex-shrink-0 w-8 h-8 px-2 py-1.5 bg-white rounded-full flex items-center justify-center">
								<span class="text-slate-600 text-sm font-sans font-medium">2</span>
							</div>
							<div class="w-80 text-white text-base font-sans font-normal leading-6">
								Dokumentasi detail epicenter, magnitudo, dan intensitas.
							</div>
						</div>

						<!-- Connector -->
						<div class="hidden md:flex items-center justify-center w-4 h-14 flex-shrink-0">
							<div class="w-px h-full bg-white"></div>
						</div>

						<!-- Step 3 -->
						<div class="flex items-start gap-3.5">
							<div class="flex-shrink-0 w-8 h-8 px-2 py-1.5 bg-white rounded-full flex items-center justify-center">
								<span class="text-slate-600 text-sm font-sans font-medium">3</span>
							</div>
							<div class="w-80 text-white text-base font-sans font-normal leading-6">
								Mendukung penelitian dan analisis risiko gempa bumi.
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Content Section -->
			<section class="snap-start w-full bg-white dark:bg-slate-900 py-24 px-12 md:px-24 overflow-hidden">
				<div class="max-w-7xl mx-auto flex flex-col gap-12">
					<!-- Header -->
					<div class="flex flex-col items-center gap-3">
						<h2 class="text-center text-4xl font-bold">
							<span class="text-slate-800 dark:text-white">Data</span>
							<span class="text-blue-600"> Seismik</span>
						</h2>
						<p class="text-center text-slate-400 dark:text-slate-400 text-base max-w-2xl">
							Kumpulan lengkap data, dokumentasi, dan rekaman dari berbagai kejadian seismik di Indonesia beserta analisis mendalam untuk penelitian dan pembelajaran.
						</p>
					</div>

					<!-- Table Wrapper -->
					<div class="overflow-x-auto rounded-lg shadow-lg border border-slate-200 dark:border-slate-600">
						<table class="w-full">
							<thead class="bg-blue-600 dark:bg-blue-200 text-white">
								<tr>
									<th class="px-6 py-4 text-left text-xs font-black uppercase tracking-widest w-12">#</th>
									<th class="px-6 py-4 text-left text-xs font-black uppercase tracking-widest">Tanggal Deteksi Gempa</th>
									<th class="px-6 py-4 text-left text-xs font-black uppercase tracking-widest">Nama Episentrum</th>
									<th class="px-6 py-4 text-center text-xs font-black uppercase tracking-widest"> magnitudo (Mpd)</th>
									<th class="px-6 py-4 text-center text-xs font-black uppercase tracking-widest">Intensitas</th>
									<th class="px-6 py-4 text-center text-xs font-black uppercase tracking-widest">Waktu Pengumuman</th>
								</tr>
							</thead>
							<tbody id="tableBody">
								<!-- Diisi oleh JavaScript -->
							</tbody>
						</table>
					</div>

					<!-- Pagination -->
					<div class="flex items-center justify-end gap-2" id="paginationContainer">
						<!-- Diisi oleh JavaScript -->
					</div>
				</div>
			</section>
		</main>
		<div class="snap-start flex flex-col justify-end">
			<Footer />
		</div>
	</div>
</Layout>

<style>
	:global {
		@import url('https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;600;700&display=swap');
	}
	.font-sans {
		font-family: 'Work Sans', sans-serif;
	}

	.richter-low   { background-color: #d1fae5; color: #065f46; }
	.richter-mid   { background-color: #fef3c7; color: #92400e; }
	.richter-high  { background-color: #fee2e2; color: #991b1b; }
	.richter-vhigh { background-color: #991b1b; color: #fee2e2; }
</style>

<script>
	const eventData = [
		{ id: 1,  date: "2026/05/21 08:11", epicenter: "Lepas Pantai Selatan Banten", richter: 3.7, intensity: "3", announce: "2026/05/21 08:15" },
		{ id: 2,  date: "2026/05/21 04:27", epicenter: "Kabupaten Lebak, Banten", richter: 3.7, intensity: "1", announce: "2026/05/21 04:30" },
		{ id: 3,  date: "2026/05/20 23:08", epicenter: "Lepas Pantai Barat Jawa Barat", richter: 2.4, intensity: "1", announce: "2026/05/20 23:11" },
		{ id: 4,  date: "2026/05/20 22:23", epicenter: "Kabupaten Sukabumi, Jawa Barat", richter: 3.5, intensity: "1", announce: "2026/05/20 22:26" },
		{ id: 5,  date: "2026/05/20 13:12", epicenter: "Teluk Jakarta, DKI Jakarta", richter: 3.8, intensity: "1", announce: "2026/05/20 13:15" },
		{ id: 6,  date: "2026/05/20 09:46", epicenter: "Laut Jawa Utara Jakarta", richter: 5.9, intensity: "5+", announce: "2026/05/20 09:51" },
		{ id: 7,  date: "2026/05/20 05:08", epicenter: "Kabupaten Pandeglang, Banten", richter: 3.2, intensity: "1", announce: "2026/05/20 05:11" },
		{ id: 8,  date: "2026/05/20 00:29", epicenter: "Selat Sunda, Banten", richter: 3.8, intensity: "1", announce: "2026/05/20 00:32" },
		{ id: 9,  date: "2026/05/19 17:35", epicenter: "Kabupaten Bogor, Jawa Barat", richter: 2.8, intensity: "2", announce: "2026/05/19 17:38" },
		{ id: 10, date: "2026/05/19 17:23", epicenter: "Kabupaten Cianjur, Jawa Barat", richter: 4.1, intensity: "1", announce: "2026/05/19 17:26" },
		{ id: 11, date: "2026/05/19 12:44", epicenter: "Lepas Pantai Selatan Jawa Barat", richter: 2.6, intensity: "1", announce: "2026/05/19 12:47" },
		{ id: 12, date: "2026/05/19 09:15", epicenter: "Kabupaten Serang, Banten", richter: 4.3, intensity: "2", announce: "2026/05/19 09:18" },
		{ id: 13, date: "2026/05/19 06:02", epicenter: "Perairan Kepulauan Seribu, DKI Jakarta", richter: 3.1, intensity: "1", announce: "2026/05/19 06:05" },
		{ id: 14, date: "2026/05/18 22:57", epicenter: "Kota Depok, Jawa Barat", richter: 2.9, intensity: "1", announce: "2026/05/18 23:00" },
		{ id: 15, date: "2026/05/18 18:33", epicenter: "Kabupaten Bekasi, Jawa Barat", richter: 4.7, intensity: "3", announce: "2026/05/18 18:37" },
		{ id: 16, date: "2026/05/18 14:21", epicenter: "Kabupaten Tangerang, Banten", richter: 3.3, intensity: "2", announce: "2026/05/18 14:24" },
		{ id: 17, date: "2026/05/18 11:09", epicenter: "Lepas Pantai Selatan Banten", richter: 3.6, intensity: "1", announce: "2026/05/18 11:12" },
		{ id: 18, date: "2026/05/18 07:48", epicenter: "Kabupaten Garut, Jawa Barat", richter: 5.1, intensity: "4", announce: "2026/05/18 07:52" },
		{ id: 19, date: "2026/05/18 03:16", epicenter: "Kota Bandung, Jawa Barat", richter: 2.2, intensity: "1", announce: "2026/05/18 03:19" },
		{ id: 20, date: "2026/05/17 21:44", epicenter: "Selat Sunda, Banten", richter: 4.4, intensity: "2", announce: "2026/05/17 21:47" },
		{ id: 21, date: "2026/05/17 16:30", epicenter: "Kabupaten Sukabumi, Jawa Barat", richter: 3.0, intensity: "1", announce: "2026/05/17 16:33" },
		{ id: 22, date: "2026/05/17 10:55", epicenter: "Jakarta Selatan, DKI Jakarta", richter: 2.7, intensity: "1", announce: "2026/05/17 10:58" },
		{ id: 23, date: "2026/05/17 05:20", epicenter: "Laut Jawa Utara Jakarta", richter: 6.2, intensity: "5-", announce: "2026/05/17 05:24" },
		{ id: 24, date: "2026/05/16 23:11", epicenter: "Kabupaten Lebak, Banten", richter: 4.0, intensity: "2", announce: "2026/05/16 23:14" },
		{ id: 25, date: "2026/05/16 18:07", epicenter: "Kabupaten Bogor, Jawa Barat", richter: 2.5, intensity: "1", announce: "2026/05/16 18:10" },
	];

	const PER_PAGE = 10;
	let currentPage = 1;
	const totalPages = Math.ceil(eventData.length / PER_PAGE);

	function getRichterClass(r) {
		if (r < 3.0) return 'richter-low';
		if (r < 4.5) return 'richter-mid';
		if (r < 5.5) return 'richter-high';
		return 'richter-vhigh';
	}

	function renderTable(page) {
		const tbody = document.getElementById('tableBody');
		tbody.innerHTML = '';
		const start = (page - 1) * PER_PAGE;
		const slice = eventData.slice(start, start + PER_PAGE);

		slice.forEach((row, index) => {
			const rowNumber = start + index + 1;
			const tr = document.createElement('tr');
			tr.className = 'border-t border-slate-200 dark:border-slate-700 hover:bg-blue-100 dark:hover:bg-blue-600/50 transition-colors duration-200 cursor-pointer group';
			tr.addEventListener('click', () => {
				window.location.href = `/product/repository-detail?id=${row.id}`;
			});
			tr.innerHTML = `
				<td class="px-6 py-4 text-sm font-bold text-slate-600 dark:text-slate-400">${rowNumber}</td>
				<td class="px-6 py-4">
					<span class="font-bold text-slate-900 dark:text-white text-sm">${row.date}</span>
				</td>
				<td class="px-6 py-4 text-sm text-slate-700 dark:text-slate-300">${row.epicenter}</td>
				<td class="px-6 py-4 text-center">
					<span class="inline-flex items-center justify-center px-3 py-1.5 rounded-lg font-bold text-xs ${getRichterClass(row.richter)}">${row.richter}</span>
				</td>
				<td class="px-6 py-4 text-center text-sm font-semibold text-slate-700 dark:text-slate-300">${row.intensity}</td>
				<td class="px-6 py-4 text-center text-xs text-slate-500 dark:text-slate-400 whitespace-nowrap">${row.announce}</td>
			`;
			tbody.appendChild(tr);
		});
	}

	function renderPagination(page) {
		const container = document.getElementById('paginationContainer');
		container.innerHTML = '';

		const info = document.createElement('span');
		info.className = 'text-xs text-slate-500 dark:text-slate-400 mr-2';
		const start = (page - 1) * PER_PAGE + 1;
		const end = Math.min(page * PER_PAGE, eventData.length);
		info.textContent = `${start}–${end} dari ${eventData.length}`;
		container.appendChild(info);

		const prev = document.createElement('button');
		prev.className = 'p-2 text-slate-600 hover:text-slate-900 dark:hover:text-white transition-colors';
		prev.disabled = page === 1;
		prev.style.opacity = page === 1 ? '0.3' : '1';
		prev.style.cursor = page === 1 ? 'not-allowed' : 'pointer';
		prev.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>`;
		prev.addEventListener('click', () => goTo(currentPage - 1));
		container.appendChild(prev);

		for (let i = 1; i <= totalPages; i++) {
			const btn = document.createElement('button');
			btn.className = `w-8 h-8 rounded text-sm font-bold transition-colors ${
				i === page
					? 'bg-blue-600 text-white'
					: 'bg-slate-100 text-slate-700 hover:bg-slate-200 dark:bg-slate-700 dark:text-slate-200 dark:hover:bg-slate-600'
			}`;
			btn.textContent = String(i);
			btn.addEventListener('click', () => goTo(i));
			container.appendChild(btn);
		}

		const next = document.createElement('button');
		next.className = 'p-2 text-slate-600 hover:text-slate-900 dark:hover:text-white transition-colors';
		next.disabled = page === totalPages;
		next.style.opacity = page === totalPages ? '0.3' : '1';
		next.style.cursor = page === totalPages ? 'not-allowed' : 'pointer';
		next.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>`;
		next.addEventListener('click', () => goTo(currentPage + 1));
		container.appendChild(next);
	}

	function goTo(page) {
		if (page < 1 || page > totalPages) return;
		currentPage = page;
		renderTable(currentPage);
		renderPagination(currentPage);
	}

	goTo(1);
</script>

